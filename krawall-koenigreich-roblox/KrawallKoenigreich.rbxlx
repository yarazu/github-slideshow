}

-- Standard-Skin je Held (erster Eintrag)
Skins.DEFAULTS = {}
for heroKind, list in pairs(Skins.HEROES) do
	Skins.DEFAULTS[heroKind] = list[1].id
end

function Skins.get(heroKind: string, id: string?)
	local list = Skins.HEROES[heroKind]
	if not list then
		return nil
	end
	for _, s in ipairs(list) do
		if s.id == id then
			return s
		end
	end
	return list[1]
end

-- Ist der Skin bei "won" gewonnenen Kämpfen verfügbar?
function Skins.isUnlocked(heroKind: string, id: string, won: number): boolean
	local s = Skins.get(heroKind, id)
	return s ~= nil and s.id == id and won >= s.unlock
end

-- Skins, die genau durch den Sieg in Kampf "level" neu dazukommen
function Skins.unlockedBy(level: number)
	local out = {}
	for _, heroKind in ipairs({ "leo", "bruna", "pip" }) do
		for _, s in ipairs(Skins.HEROES[heroKind]) do
			if s.unlock == level then
				table.insert(out, { hero = heroKind, skin = s })
			end
		end
	end
	return out
end

return Skins
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="7">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Folder" referent="8">
      <Properties>
        <string name="Name">KrawallServer</string>
      </Properties>
      <Item class="Script" referent="9">
        <Properties>
          <string name="Name">Progress</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[-- Server: Welt vorbereiten (Wasser, Wolken) und Spielfortschritt samt Skin-Auswahl per DataStore speichern.
-- Gespielt wird auf dem Client; der Server speichert nur, was der Spieler freigeschaltet und ausgerüstet hat.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local DataStoreService = game:GetService("DataStoreService")

local Shared = ReplicatedStorage:WaitForChild("Krawall")
local Config = require(Shared:WaitForChild("Config"))
local Skins = require(Shared:WaitForChild("Skins"))

-- Kein Avatar: das Spiel wird mit Maus, Tastatur oder Touch über eine freie Kamera gesteuert
Players.CharacterAutoLoads = false

local remote = Instance.new("RemoteFunction")
remote.Name = "KrawallProgress"
remote.Parent = ReplicatedStorage

-- Wasser rund um die schwebenden Spielfelder und ein paar Wolken
task.spawn(function()
	local terrain = workspace.Terrain
	pcall(function()
		terrain:FillBlock(CFrame.new(0, -7, 0), Vector3.new(640, 10, 640), Enum.Material.Water)
	end)
	terrain.WaterTransparency = 0.55
	terrain.WaterWaveSize = 0.18
	terrain.WaterWaveSpeed = 8
	terrain.WaterReflectance = 0.35
	pcall(function()
		local clouds = terrain:FindFirstChildOfClass("Clouds") or Instance.new("Clouds")
		clouds.Cover = 0.55
		clouds.Density = 0.6
		clouds.Parent = terrain
	end)
end)

local store = nil
do
	local ok, result = pcall(function()
		return DataStoreService:GetDataStore("KrawallKoenigreich_v1")
	end)
	if ok then
		store = result
	end
end

local cache = {} -- UserId -> Daten
local dirty = {} -- UserId -> true, wenn noch nicht gespeichert

local function defaults()
	return { won = 0, best = {}, skins = table.clone(Skins.DEFAULTS) }
end

-- Nur bekannte Felder mit gültigen Werten übernehmen
local function sanitize(data, base)
	local out = defaults()
	if base then
		out.won = base.won
		out.best = table.clone(base.best)
		out.skins = table.clone(base.skins)
	end
	if type(data) ~= "table" then
		return out
	end
	local won = tonumber(data.won)
	if won then
		out.won = math.clamp(math.floor(won), out.won, #Config.LEVELS)
	end
	if type(data.best) == "table" then
		for i = 1, #Config.LEVELS do
			local b = data.best[tostring(i)]
			if type(b) == "table" and tonumber(b.score) and tonumber(b.turn) then
				out.best[tostring(i)] = { score = math.clamp(math.floor(b.score), 1, 3), turn = math.clamp(math.floor(b.turn), 1, 99) }
			end
		end
	end
	if type(data.skins) == "table" then
		for heroKind in pairs(Skins.DEFAULTS) do
			local id = data.skins[heroKind]
			if type(id) == "string" and Skins.isUnlocked(heroKind, id, out.won) then
				out.skins[heroKind] = id
			end
		end
	end
	return out
end

local function load(player: Player)
	local data = nil
	if store then
		local ok, result = pcall(function()
			return store:GetAsync("p_" .. player.UserId)
		end)
		if ok then
			data = result
		else
			warn("Krawall: Fortschritt konnte nicht geladen werden (in Studio ist das normal, solange API-Zugriff aus ist): " .. tostring(result))
		end
	end
	cache[player.UserId] = sanitize(data)
	return cache[player.UserId]
end

local function save(userId: number)
	local data = cache[userId]
	if not store or not data or not dirty[userId] then
		return
	end
	dirty[userId] = nil
	local ok, err = pcall(function()
		store:SetAsync("p_" .. userId, data)
	end)
	if not ok then
		dirty[userId] = true
		warn("Krawall: Speichern fehlgeschlagen: " .. tostring(err))
	end
end

remote.OnServerInvoke = function(player: Player, action: string, data)
	if action == "load" then
		return cache[player.UserId] or load(player)
	elseif action == "save" then
		local current = cache[player.UserId] or load(player)
		cache[player.UserId] = sanitize(data, current)
		dirty[player.UserId] = true
		return true
	end
	return nil
end

Players.PlayerRemoving:Connect(function(player)
	save(player.UserId)
	cache[player.UserId] = nil
	dirty[player.UserId] = nil
end)

game:BindToClose(function()
	for userId in pairs(dirty) do
		save(userId)
	end
end)

-- regelmäßig speichern, statt bei jeder Änderung (DataStore-Limits)
task.spawn(function()
	while true do
		task.wait(30)
		for userId in pairs(dirty) do
			save(userId)
		end
	end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="10">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="11">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="12">
        <Properties>
          <string name="Name">KrawallClient</string>
          <string name="Source"><![CDATA[-- Krawall-Königreich: Client-Steuerung.
-- Baut das Spielfeld, animiert die Ereignisse aus Rules.luau, steuert Kamera, Eingabe und Menüs.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local StarterGui = game:GetService("StarterGui")

local Shared = ReplicatedStorage:WaitForChild("Krawall")
local Config = require(Shared:WaitForChild("Config"))
local Skins = require(Shared:WaitForChild("Skins"))
local Rules = require(Shared:WaitForChild("Rules"))
local Fx = require(script:WaitForChild("Fx"))
local Models = require(script:WaitForChild("Models"))
local Board = require(script:WaitForChild("Board"))
local Ui = require(script:WaitForChild("Ui"))

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local TILE = Config.TILE
local key = Rules.key

local function hex(c: string): Color3
	return Color3.fromHex(c)
end

local COL = {
	dash = hex("#ff8a2a"),
	stomp = hex("#ff5fd2"),
	c100 = hex("#5fd068"),
	c50 = hex("#ffc63d"),
	c0 = hex("#8d80a8"),
	range = hex("#ff5a4a"),
	area = hex("#5ee3d2"),
	gold = hex("#ffc63d"),
	white = Color3.new(1, 1, 1),
	foeShot = hex("#ff5fd2"),
	crate = hex("#c98a4b"),
}

-- Standard-Steuerung und Roblox-Oberflächen ausblenden, die das HUD verdecken (keine Spielfigur, jeder spielt für sich)
for _, t in ipairs({ Enum.CoreGuiType.Backpack, Enum.CoreGuiType.Health, Enum.CoreGuiType.EmotesMenu, Enum.CoreGuiType.PlayerList, Enum.CoreGuiType.Chat }) do
	pcall(function()
		StarterGui:SetCoreGuiEnabled(t, false)
	end)
end
task.spawn(function()
	pcall(function()
		local pm = require(player:WaitForChild("PlayerScripts"):WaitForChild("PlayerModule", 10) :: ModuleScript)
		pm:GetControls():Disable()
	end)
end)

local world = Instance.new("Folder")
world.Name = "KrawallWelt"
world.Parent = workspace
local fxFolder = Instance.new("Folder")
fxFolder.Name = "Effekte"
fxFolder.Parent = world
Fx.folder = fxFolder

-- ------------------------------------------------------------------ progress (Server speichert per DataStore)

local progress = { won = 0, best = {}, skins = table.clone(Skins.DEFAULTS) }
local remote = ReplicatedStorage:WaitForChild("KrawallProgress", 10) :: RemoteFunction?

local function loadProgress()
	if not remote then
		return
	end
	local ok, data = pcall(function()
		return remote:InvokeServer("load")
	end)
	if ok and type(data) == "table" then
		progress.won = math.clamp(tonumber(data.won) or 0, 0, #Config.LEVELS)
		if type(data.best) == "table" then
			progress.best = data.best
		end
		if type(data.skins) == "table" then
			for heroKind in pairs(Skins.DEFAULTS) do
				local want = data.skins[heroKind]
				if type(want) == "string" and Skins.isUnlocked(heroKind, want, progress.won) then
					progress.skins[heroKind] = want
				end
			end
		end
	end
end

local function saveProgress()
	if not remote then
		return
	end
	local snapshot = { won = progress.won, best = progress.best, skins = table.clone(progress.skins) }
	task.spawn(function()
		pcall(function()
			remote:InvokeServer("save", snapshot)
		end)
	end)
end

-- ------------------------------------------------------------------ state

local App = {
	phase = "title", -- title | player | enemy | over
	G = nil,
	board = nil,
	li = 1,
	pick = 1,
	selected = nil,
	mode = nil :: string?,
	busy = false,
	moveOpts = nil,
	hover = nil,
	touchPending = nil :: string?,
	run = 0,
	speed = 1,
	paused = false,
	helpReturn = nil :: string?,
	skinsReturn = nil :: string?,
}
local VU = {} -- Einheiten-ID -> Darstellung
local rnd = Random.new()
local ui

local cam = { yaw = 0, pitch = 0.95, dist = 70, target = Vector3.zero }
local goal = { yaw = 0, pitch = 0.95, dist = 70, target = Vector3.zero }

local function tp(x: number, z: number, y: number?): Vector3
	return App.board:tilePos(x, z, y)
end

local function unitTop(vu, extra: number?): Vector3
	return vu.pos + Vector3.new(0, vu.height + (extra or 0.8), 0)
end

local function faceTo(vu, p: Vector3)
	local dx, dz = p.X - vu.pos.X, p.Z - vu.pos.Z
	if math.abs(dx) + math.abs(dz) > 1e-3 then
		vu.yawGoal = math.atan2(-dx, -dz)
	end
end

local function muzzleWorld(vu): Vector3
	return vu.pos + CFrame.Angles(0, vu.yawGoal, 0):VectorToWorldSpace(vu.muzzle)
end

local function focus(p: Vector3, weight: number?)
	goal.target = Vector3.new(p.X, 0, p.Z) * (weight or 0.6)
end

-- ------------------------------------------------------------------ unit visuals

local function disc(color: Color3, d: number, h: number, material: Enum.Material): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	p.Shape = Enum.PartType.Cylinder
	p.Size = Vector3.new(h, d, d)
	p.Color = color
	p.Material = material
	p.Transparency = 1
	p.Parent = App.board.folder
	return p
end

local function setChips(vu, st)
	for _, c in ipairs(vu.chips:GetChildren()) do
		if c:IsA("TextLabel") then
			c:Destroy()
		end
	end
	local list = {}
	if st.alive == false then
		table.insert(list, { "K.O.", "#5b4e74", "#e2daf3" })
	end
	if st.burn then
		table.insert(list, { "BRAND", "#ff7a2f", "#2b0e00" })
	end
	if st.honey then
		table.insert(list, { "HONIG", "#ffd23d", "#3a2700" })
	end
	if st.shield then
		table.insert(list, { "SCHILD", "#5ee3d2", "#05302b" })
	end
	if st.overwatch then
		table.insert(list, { "WACHE", "#ffffff", "#3a1d05" })
	end
	for i, c in ipairs(list) do
		local l = Instance.new("TextLabel")
		l.Text = c[1]
		l.Font = Enum.Font.GothamBold
		l.TextSize = 11
		l.BackgroundColor3 = hex(c[2])
		l.TextColor3 = hex(c[3])
		l.Size = UDim2.fromOffset(0, 15)
		l.AutomaticSize = Enum.AutomaticSize.X
		l.LayoutOrder = i
		local pad = Instance.new("UIPadding")
		pad.PaddingLeft = UDim.new(0, 4)
		pad.PaddingRight = UDim.new(0, 4)
		pad.Parent = l
		local cr = Instance.new("UICorner")
		cr.CornerRadius = UDim.new(0, 4)
		cr.Parent = l
		l.Parent = vu.chips
	end
	vu.status = st
end

local function refreshBar(vu)
	local r = math.clamp(vu.hp / vu.maxHp, 0, 1)
	vu.fill.Size = UDim2.fromScale(r, 1)
	if vu.team == "hero" then
		vu.fill.BackgroundColor3 = if r > 0.5 then COL.c100 elseif r > 0.25 then COL.c50 else hex("#ff5a5a")
	end
end

local function makeVisual(u)
	local model, info
	if u.team == "hero" then
		model, info = Models.hero(u.kind, Skins.get(u.kind, progress.skins[u.kind]))
	else
		model, info = Models.enemy(u.kind, u.def)
	end
	model.Parent = App.board.folder
	local h = info.height
	local vu = {
		id = u.id,
		unit = u,
		team = u.team,
		model = model,
		height = h,
		muzzle = info.muzzle,
		shotColor = if u.team == "hero" then info.glow else COL.foeShot,
		pos = tp(u.x, u.z),
		yaw = if u.team == "hero" then 0 else math.pi,
		yawGoal = if u.team == "hero" then 0 else math.pi,
		lift = 0,
		flip = 0,
		tilt = 0,
		phase = rnd:NextNumber() * math.pi * 2,
		alive = u.alive,
		hp = u.hp,
		maxHp = u.maxHp,
		flash = 0,
		hlColor = nil,
		status = { burn = false, honey = false, shield = false, overwatch = false, alive = true },
	}
	-- Trefferfläche (außerhalb des Modells, damit Highlights sauber bleiben)
	local hit = Instance.new("Part")
	hit.Anchored = true
	hit.CanCollide = false
	hit.CanTouch = false
	hit.CanQuery = true
	hit.Transparency = 1
	hit.Size = Vector3.new(3.4, h, 3.4)
	hit:SetAttribute("UnitId", u.id)
	hit.Parent = App.board.folder
	vu.hitbox = hit
	local hl = Instance.new("Highlight")
	hl.Enabled = false
	hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
	hl.Parent = model
	vu.hl = hl
	vu.ring = disc(COL.gold, 3.9, 0.12, Enum.Material.Neon)
	vu.watch = disc(COL.white, 4.3, 0.1, Enum.Material.Neon)
	vu.honey = disc(hex("#ffc21a"), 3.4, 0.16, Enum.Material.SmoothPlastic)
	local bubble = Instance.new("Part")
	bubble.Anchored = true
	bubble.CanCollide = false
	bubble.CanQuery = false
	bubble.CanTouch = false
	bubble.CastShadow = false
	bubble.Shape = Enum.PartType.Ball
	bubble.Size = Vector3.new(h * 1.15, h * 1.15, h * 1.15)
	bubble.Color = hex("#5ee3d2")
	bubble.Material = Enum.Material.ForceField
	bubble.Transparency = 1
	bubble.Parent = App.board.folder
	vu.bubble = bubble

	-- Lebensbalken & Statusanzeige
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(if u.def.boss then 140 else 96, 70)
	bb.StudsOffsetWorldSpace = Vector3.new(0, h / 2 + 1.6, 0)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.MaxDistance = 400
	bb.Adornee = hit
	bb.Parent = hit
	local layout = Instance.new("UIListLayout")
	layout.FillDirection = Enum.FillDirection.Vertical
	layout.VerticalAlignment = Enum.VerticalAlignment.Bottom
	layout.HorizontalAlignment = Enum.HorizontalAlignment.Center
	layout.SortOrder = Enum.SortOrder.LayoutOrder
	layout.Padding = UDim.new(0, 2)
	layout.Parent = bb
	local chance = Instance.new("TextLabel")
	chance.Font = Enum.Font.FredokaOne
	chance.TextSize = 17
	chance.Size = UDim2.fromOffset(0, 20)
	chance.AutomaticSize = Enum.AutomaticSize.X
	chance.Visible = false
	chance.LayoutOrder = 1
	local cpad = Instance.new("UIPadding")
	cpad.PaddingLeft = UDim.new(0, 7)
	cpad.PaddingRight = UDim.new(0, 7)
	cpad.Parent = chance
	local ccr = Instance.new("UICorner")
	ccr.CornerRadius = UDim.new(0, 8)
	ccr.Parent = chance
	chance.Parent = bb
	local nameLbl = Instance.new("TextLabel")
	nameLbl.BackgroundTransparency = 1
	nameLbl.Font = Enum.Font.GothamBold
	nameLbl.TextSize = 13
	nameLbl.TextColor3 = COL.white
	nameLbl.Text = u.name
	nameLbl.Size = UDim2.new(1, 0, 0, 15)
	nameLbl.Visible = u.def.boss == true
	nameLbl.LayoutOrder = 2
	local ns = Instance.new("UIStroke")
	ns.Thickness = 2
	ns.Color = hex("#120c20")
	ns.Parent = nameLbl
	nameLbl.Parent = bb
	local bar = Instance.new("Frame")
	bar.Size = UDim2.fromOffset(if u.def.boss then 120 else 64, 9)
	bar.BackgroundColor3 = hex("#120c20")
	bar.BorderSizePixel = 0
	bar.LayoutOrder = 3
	local bcr = Instance.new("UICorner")
	bcr.CornerRadius = UDim.new(0, 4)
	bcr.Parent = bar
	bar.Parent = bb
	local fill = Instance.new("Frame")
	fill.Size = UDim2.fromScale(1, 1)
	fill.BackgroundColor3 = if u.team == "hero" then COL.c100 else hex("#ff5a7a")
	fill.BorderSizePixel = 0
	local fcr = Instance.new("UICorner")
	fcr.CornerRadius = UDim.new(0, 4)
	fcr.Parent = fill
	fill.Parent = bar
	local chips = Instance.new("Frame")
	chips.BackgroundTransparency = 1
	chips.Size = UDim2.new(1, 0, 0, 15)
	chips.LayoutOrder = 4
	local cl = Instance.new("UIListLayout")
	cl.FillDirection = Enum.FillDirection.Horizontal
	cl.HorizontalAlignment = Enum.HorizontalAlignment.Center
	cl.Padding = UDim.new(0, 2)
	cl.SortOrder = Enum.SortOrder.LayoutOrder
	cl.Parent = chips
	chips.Parent = bb
	vu.bb, vu.chance, vu.nameLbl, vu.fill, vu.chips = bb, chance, nameLbl, fill, chips
	VU[u.id] = vu
	refreshBar(vu)
	setChips(vu, Rules.statusOf(App.G, u))
	return vu
end

local function destroyVisual(vu)
	vu.model:Destroy()
	for _, p in ipairs({ vu.hitbox, vu.ring, vu.watch, vu.honey, vu.bubble }) do
		p:Destroy()
	end
	VU[vu.id] = nil
end

-- Skin eines Helden während des Spiels austauschen (Zustand bleibt erhalten)
local function reskin(heroKind: string)
	if not App.G then
		return
	end
	for _, u in ipairs(App.G.units) do
		local old = VU[u.id]
		if u.kind == heroKind and old then
			local keep = { pos = old.pos, yaw = old.yaw, yawGoal = old.yawGoal, hp = old.hp, alive = old.alive, status = old.status, tilt = old.tilt }
			destroyVisual(old)
			local vu = makeVisual(u)
			for k, v in pairs(keep) do
				vu[k] = v
			end
			refreshBar(vu)
			setChips(vu, vu.status)
		end
	end
end

local function updateVisuals(dt: number, t: number)
	for _, vu in pairs(VU) do
		local d = vu.yawGoal - vu.yaw
		d = math.atan2(math.sin(d), math.cos(d))
		vu.yaw += d * math.min(1, dt * 12)
		local bob = if vu.alive then math.abs(math.sin(t * 2.4 + vu.phase)) * 0.14 else 0
		local base = vu.pos + Vector3.new(0, vu.lift + bob, 0)
		local cf = CFrame.new(base) * CFrame.Angles(0, vu.yaw, 0)
		if vu.flip ~= 0 then
			cf = cf * CFrame.new(0, vu.height / 2, 0) * CFrame.Angles(vu.flip, 0, 0) * CFrame.new(0, -vu.height / 2, 0)
		end
		if vu.tilt ~= 0 then
			cf = cf * CFrame.new(0, 0.6, 0) * CFrame.Angles(vu.tilt, 0, 0)
		end
		vu.model:PivotTo(cf)
		vu.hitbox.CFrame = CFrame.new(base + Vector3.new(0, vu.height / 2, 0))
		local flat = CFrame.new(vu.pos) * CFrame.Angles(0, 0, math.rad(90))
		local selected = App.selected ~= nil and App.selected.id == vu.id and App.phase == "player" and vu.alive
		vu.ring.CFrame = flat + Vector3.new(0, 0.1, 0)
		vu.ring.Transparency = if selected then 0.25 + math.sin(t * 5) * 0.15 else 1
		vu.watch.CFrame = flat + Vector3.new(0, 0.14, 0)
		vu.watch.Transparency = if vu.alive and vu.status.overwatch then 0.45 else 1
		vu.honey.CFrame = flat + Vector3.new(0, 0.09, 0)
		vu.honey.Transparency = if vu.alive and vu.status.honey then 0.15 else 1
		vu.bubble.CFrame = CFrame.new(base + Vector3.new(0, vu.height / 2, 0))
		vu.bubble.Transparency = if vu.alive and vu.status.shield then 0 else 1
		-- Highlight: Treffer-Blitz hat Vorrang vor Zielmarkierung
		local hl = vu.hl
		if vu.flash > 0 then
			vu.flash = math.max(0, vu.flash - dt * 4.5)
			hl.Enabled = true
			hl.FillColor = COL.white
			hl.FillTransparency = 1 - 0.8 * vu.flash
			hl.OutlineTransparency = 1
		elseif vu.hlColor then
			hl.Enabled = true
			hl.FillColor = vu.hlColor
			hl.OutlineColor = vu.hlColor
			hl.FillTransparency = 0.82
			hl.OutlineTransparency = 0
		else
			hl.Enabled = false
		end
		if vu.alive and vu.status.burn and rnd:NextNumber() < dt * 8 then
			Fx.burst(unitTop(vu, -0.6), if rnd:NextNumber() < 0.5 then hex("#ff7a2f") else hex("#ffc63d"), 1, 2, 0.5, 0.28, 5, -0.3)
		end
	end
end

local function syncVisuals()
	for _, u in ipairs(App.G.units) do
		local vu = VU[u.id]
		if vu and u.alive then
			vu.pos = tp(u.x, u.z)
			vu.lift = 0
			vu.flip = 0
			vu.hp = u.hp
			refreshBar(vu)
			setChips(vu, App.G:statusOf(u))
		end
	end
end

-- ------------------------------------------------------------------ animation helpers

local function jumpArc(vu, to: Vector3, height: number, dur: number, flip: boolean)
	local from = vu.pos
	faceTo(vu, to)
	Fx.sound("jump")
	Fx.tween(dur, function(k)
		vu.pos = from:Lerp(to, k)
		vu.lift = math.sin(math.pi * k) * height
		if flip then
			vu.flip = -Fx.ease(k) * math.pi * 2
		end
	end)
	vu.flip = 0
	vu.lift = 0
end

local function lunge(vu, target: Vector3, frac: number)
	local from = vu.pos
	faceTo(vu, target)
	local mid = from:Lerp(Vector3.new(target.X, from.Y, target.Z), frac)
	Fx.tween(0.12, function(k)
		vu.pos = from:Lerp(mid, Fx.ease(k))
	end)
	Fx.tween(0.16, function(k)
		vu.pos = mid:Lerp(from, Fx.ease(k))
	end)
	vu.pos = from
end

local function boost(vu)
	if not vu then
		return
	end
	Fx.tween(0.12, function(k)
		vu.lift = -k * 0.6
	end)
	task.spawn(function()
		Fx.tween(0.2, function(k)
			vu.lift = -0.6 + k * 0.6
		end)
		vu.lift = 0
	end)
end

local function setScale(model: Model, s: number)
	pcall(function()
		model:ScaleTo(math.max(0.01, s))
	end)
end

-- ------------------------------------------------------------------ event playback

local H = {}

function H.step(e)
	local vu = VU[e.unit]
	local from, to = vu.pos, tp(e.x, e.z)
	faceTo(vu, to)
	Fx.tween(0.17, function(k)
		vu.pos = from:Lerp(to, k)
		vu.lift = math.sin(k * math.pi) * 0.6
	end)
	vu.lift = 0
	Fx.sound("step")
	if vu.team == "enemy" then
		focus(to, 0.7)
	end
end

function H.jump(e)
	local vu = VU[e.unit]
	local to = tp(e.x, e.z)
	faceTo(vu, to)
	boost(VU[e.via])
	jumpArc(vu, to, 8.5, 0.55, true)
	Fx.sound("land")
	Fx.burst(to + Vector3.new(0, 0.3, 0), COL.white, 10, 8, 0.4, 0.3, 2)
end

function H.stomp(e)
	local vu, target = VU[e.unit], VU[e.target]
	faceTo(vu, target.pos)
	boost(VU[e.via])
	jumpArc(vu, target.pos + Vector3.new(0, target.height * 0.85, 0), 9.5, 0.55, true)
	Fx.floatText(unitTop(target, 1.8), "Sprungangriff!", "fx")
end

function H.land(e)
	local vu = VU[e.unit]
	local from = vu.pos
	local to = tp(e.x, e.z)
	faceTo(vu, to)
	Fx.tween(0.4, function(k)
		vu.pos = from:Lerp(to, k)
		vu.lift = (1 - k) * (from.Y - to.Y) + math.sin(math.pi * k) * 4
	end)
	vu.pos = to
	vu.lift = 0
	Fx.sound("land")
end

function H.dash(e)
	local vu, target = VU[e.unit], VU[e.target]
	Fx.sound("dash")
	Fx.floatText(unitTop(target, 1.8), "Sprint!", "fx")
	lunge(vu, target.pos, 0.7)
	Fx.burst(target.pos + Vector3.new(0, 2, 0), COL.dash, 14, 12, 0.5, 0.4)
end

function H.shot(e)
	local a, t = VU[e.attacker], VU[e.target]
	faceTo(a, t.pos)
	if e.reaction then
		focus((a.pos + t.pos) / 2, 0.8)
	end
	Fx.sleep(0.18)
	if e.melee then
		Fx.sound("dash")
		lunge(a, t.pos, 0.55)
		return
	end
	Fx.sound("shoot")
	local from = muzzleWorld(a)
	local to = t.pos + Vector3.new(0, t.height * 0.55, 0)
	if not e.hit then
		if e.coverX then
			to = tp(e.coverX, e.coverZ, if e.coverWall then 4 else 1.8)
		else
			local dir = (to - from).Unit
			to += Vector3.new(-dir.Z, 0, dir.X) * (if rnd:NextNumber() < 0.5 then -3 else 3)
		end
	end
	Fx.projectile(from, to, a.shotColor)
end

function H.damage(e)
	local vu = VU[e.unit]
	vu.hp = e.hp
	refreshBar(vu)
	Fx.floatText(unitTop(vu, 1.2), "-" .. e.amount, if vu.team == "hero" then "heroDmg" else "dmg")
	vu.flash = 1
	Fx.shake(if vu.team == "hero" then 0.6 else 0.35)
	if not e.quiet then
		Fx.sound("hit")
	end
	ui:refresh()
end

function H.ko(e)
	local vu = VU[e.unit]
	vu.alive = false
	vu.hitbox.CanQuery = false
	Fx.sound("ko")
	setChips(vu, { alive = false })
	if vu.team == "enemy" then
		Fx.floatText(unitTop(vu, 1.6), "Besiegt!", "fx")
		Fx.burst(vu.pos + Vector3.new(0, 2, 0), vu.unit.def and hex(vu.unit.def.color) or COL.white, 22, 14, 0.8, 0.45)
		Fx.burst(vu.pos + Vector3.new(0, 2, 0), COL.white, 10, 10, 0.6, 0.35)
		vu.bb.Enabled = false
		task.spawn(function()
			local startYaw = vu.yawGoal
			Fx.tween(0.45, function(k)
				vu.yawGoal = startYaw + k * 6
				setScale(vu.model, 1 - Fx.ease(k))
			end)
			if VU[vu.id] == vu then
				destroyVisual(vu)
			end
		end)
	else
		Fx.floatText(unitTop(vu, 1.6), "K.O.!", "fx")
		for _, p in ipairs(vu.model:GetDescendants()) do
			if p:IsA("BasePart") then
				p.Color = p.Color:Lerp(Color3.fromRGB(119, 119, 136), 0.6)
			end
		end
		Fx.tween(0.5, function(k)
			vu.tilt = Fx.ease(k) * math.pi / 2
		end)
	end
	ui:refresh()
end

function H.effect(e)
	local vu = VU[e.unit]
	if e.effect == "burn" then
		Fx.floatText(unitTop(vu, 1.8), "Brand!", "fx")
		Fx.burst(unitTop(vu, -1), hex("#ff7a2f"), 10, 6, 0.6, 0.3, 6, -0.2)
	elseif e.effect == "honey" then
		Fx.floatText(unitTop(vu, 1.8), "Honig!", "fx")
		Fx.burst(vu.pos + Vector3.new(0, 0.5, 0), hex("#ffc21a"), 10, 6, 0.6, 0.3)
	end
end

function H.float(e)
	local vu = VU[e.unit]
	if vu then
		Fx.floatText(unitTop(vu, 1.8), e.text, e.style)
	end
end

function H.cover(e)
	local c = App.board:crateHit(e.x, e.z, e.destroyed)
	Fx.sound("crack")
	Fx.burst(c, COL.crate, if e.destroyed then 18 else 8, 10, 0.6, 0.4)
	Fx.floatText(c + Vector3.new(0, 2.5, 0), if e.destroyed then "Kiste zerstört" else "Kiste beschädigt", "info")
end

function H.slide(e)
	local vu = VU[e.unit]
	local from, to = vu.pos, tp(e.x, e.z)
	Fx.tween(0.13, function(k)
		vu.pos = from:Lerp(to, Fx.ease(k))
	end)
end

function H.bump(e)
	local vu = VU[e.unit]
	lunge(vu, tp(e.x, e.z), 0.35)
	Fx.floatText(tp(e.x, e.z, 4), "Rums!", "info")
end

function H.fall(e)
	local vu = VU[e.unit]
	local from, to = vu.pos, tp(e.x, e.z)
	Fx.tween(0.16, function(k)
		vu.pos = from:Lerp(to, k)
		vu.lift = math.sin(k * math.pi) * 1.5
	end)
	Fx.tween(0.3, function(k)
		vu.lift = -k * 6
	end)
	Fx.sound("splash")
	Fx.burst(tp(e.x, e.z, -2), hex("#bfe8ff"), 22, 10, 0.7, 0.4, 12)
	Fx.floatText(tp(e.x, e.z, 2.5), "Platsch!", "info")
end

function H.respawn(e)
	local vu = VU[e.unit]
	vu.pos = tp(e.x, e.z)
	Fx.tween(0.3, function(k)
		vu.lift = (1 - k * k) * 10
	end)
	vu.lift = 0
	Fx.burst(vu.pos, COL.white, 8, 8, 0.4, 0.3)
end

function H.tech(e)
	local vu = VU[e.unit]
	if e.tech == "overwatch" then
		Fx.sound("watch")
		Fx.floatText(unitTop(vu, 1.5), "Wachsam!", "info")
		Fx.ringWave(vu.pos, COL.white, e.radius * TILE)
	elseif e.tech == "shield" then
		Fx.sound("shield")
		Fx.ringWave(vu.pos, COL.area, e.radius * TILE)
	else
		Fx.sound("heal")
		Fx.ringWave(vu.pos, hex("#7dff8a"), e.radius * TILE)
	end
end

function H.heal(e)
	local vu = VU[e.unit]
	vu.hp = e.hp
	refreshBar(vu)
	Fx.floatText(unitTop(vu, 1.2), "+" .. e.amount, "heal")
	Fx.burst(vu.pos + Vector3.new(0, 1, 0), hex("#7dff8a"), 12, 5, 0.9, 0.3, 5, -0.25)
	ui:refresh()
end

function H.status(e)
	local vu = VU[e.unit]
	if vu then
		setChips(vu, e.status)
	end
end

function H.burn(e)
	local vu = VU[e.unit]
	Fx.floatText(unitTop(vu, 1.8), "Brand", "fx")
	Fx.burst(unitTop(vu, -1), hex("#ff7a2f"), 12, 6, 0.6, 0.35, 6, -0.2)
	Fx.sleep(0.25)
end

function H.turn(e)
	local L = App.G.level
	ui:setRound(e.round, e.phase)
	if e.phase == "player" then
		Fx.sound("turn")
		if e.first then
			ui:showBanner(L.name, "Kampf " .. App.li .. " · " .. L.goal, false)
		else
			ui:showBanner("Dein Zug", "Runde " .. e.round, false)
		end
	else
		Fx.sound("foe")
		ui:showBanner("Gegnerzug", "Die Krawallos greifen an", true)
	end
	Fx.sleep(1.1)
end

function H.banner(e)
	ui:showBanner(e.title, e.sub, e.foe)
	Fx.sleep(1.1)
end

function H.shock(e)
	local vu = VU[e.unit]
	Fx.floatText(unitTop(vu, 1.8), "Schockwelle!", "fx")
	Fx.sound("quake")
	Fx.shake(1.4)
	Fx.ringWave(vu.pos, COL.stomp, e.radius * TILE)
end

function H.spawn(e)
	local u = App.G.byId[e.unit]
	local vu = makeVisual(u)
	vu.pos = tp(e.x, e.z)
	Fx.burst(vu.pos + Vector3.new(0, 1.5, 0), hex("#c23cd6"), 16, 10, 0.6, 0.4)
	Fx.tween(0.35, function(k)
		vu.lift = (1 - Fx.ease(k)) * 8
	end)
	vu.lift = 0
end

function H.enemyStart(e)
	local vu = VU[e.unit]
	if vu then
		focus(vu.pos, 0.7)
		vu.nameLbl.Visible = true
	end
	Fx.sleep(0.3)
end

function H.enemyEnd(e)
	local vu = VU[e.unit]
	if vu then
		vu.nameLbl.Visible = vu.unit.def.boss == true
	end
	Fx.sleep(0.12)
end

local function play(events): boolean
	local run = App.run
	for _, e in ipairs(events) do
		if run ~= App.run then
			return false
		end
		local fn = H[e.kind]
		-- Ereignisse zu bereits entfernten Figuren überspringen (z. B. besiegte Gegner)
		local missing = (e.kind ~= "spawn" and e.unit ~= nil and VU[e.unit] == nil)
			or (e.target ~= nil and VU[e.target] == nil)
			or (e.attacker ~= nil and VU[e.attacker] == nil)
		if fn and not missing then
			local ok, err = pcall(fn, e)
			if not ok then
				warn("Krawall: Animation für " .. tostring(e.kind) .. " fehlgeschlagen: " .. tostring(err))
			end
		end
	end
	return run == App.run
end

-- ------------------------------------------------------------------ highlights & hover

local function chanceCol(c: number): Color3
	return if c >= 100 then COL.c100 elseif c > 0 then COL.c50 else COL.c0
end

local function showChance(vu, c: number)
	vu.chance.Text = c .. " %"
	vu.chance.Visible = true
	vu.chance.BackgroundColor3 = chanceCol(c)
	vu.chance.TextColor3 = if c >= 100 then hex("#0f2a12") elseif c > 0 then hex("#2a1a00") else hex("#e2daf3")
end

local function clearChances()
	for _, vu in pairs(VU) do
		vu.chance.Visible = false
	end
end

local function clearHighlights()
	if not App.board then
		return
	end
	local b = App.board
	b:clearOverlays()
	b:clearDanger()
	b:clearDots()
	b:hideShields()
	b:hideRange()
	b:setHover(nil)
	for _, vu in pairs(VU) do
		vu.hlColor = nil
		vu.chance.Visible = false
		vu.nameLbl.Visible = vu.unit.def.boss == true
	end
end

local applyHover

local function defaultMode(h): string?
	if not h or not h.alive then
		return nil
	end
	if not h.moved then
		return "move"
	end
	if not h.attacked then
		return "attack"
	end
	return nil
end

local function refreshHighlights()
	if not App.board then
		return
	end
	clearHighlights()
	App.moveOpts = nil
	if App.phase ~= "player" or App.busy then
		return
	end
	local G, b, h = App.G, App.board, App.selected
	if not h or not h.alive then
		return
	end
	if App.mode == "move" then
		local o = G:computeMoveOptions(h)
		App.moveOpts = o
		for _, v in pairs(o.walk) do
			if not (v.x == h.x and v.z == h.z) then
				b:setOverlay(v.x, v.z, "move")
			end
		end
		for _, v in pairs(o.jump) do
			b:setOverlay(v.x, v.z, "jump")
		end
		for k, v in pairs(o.stomp) do
			if not o.dash[k] and VU[v.enemy.id] then
				VU[v.enemy.id].hlColor = COL.stomp
			end
		end
		for _, v in pairs(o.dash) do
			if VU[v.enemy.id] then
				VU[v.enemy.id].hlColor = COL.dash
			end
		end
	elseif App.mode == "attack" then
		local w = h.def.weapon
		b:showRange(h.x, h.z, w.range, COL.range)
		for z = 0, G.H - 1 do
			for x = 0, G.W - 1 do
				if G:tileAt(x, z).type == "floor" and math.sqrt((x - h.x) ^ 2 + (z - h.z) ^ 2) <= w.range + 1e-6 and not (x == h.x and z == h.z) then
					b:setOverlay(x, z, "range")
				end
			end
		end
		for _, e in ipairs(G:foes()) do
			local info = G:shotInfo(h, h.x, h.z, e)
			local vu = VU[e.id]
			if info.inRange and vu then
				vu.hlColor = chanceCol(info.chance)
				showChance(vu, info.chance)
			end
		end
	elseif App.mode == "tech" then
		local area, r = G:techArea(h)
		local ow = h.def.tech.id == "overwatch"
		b:showRange(h.x, h.z, r, if ow then COL.white else COL.area)
		for _, p in ipairs(area) do
			b:setOverlay(p[1], p[2], if ow then "range" else "area")
		end
	end
	if App.hover then
		applyHover(App.hover)
	end
end

local function hitKey(hit): string
	if not hit then
		return ""
	end
	if hit.unit then
		return "u" .. hit.unit.id
	end
	return "t" .. hit.tile.x .. "," .. hit.tile.z
end

local function pct(n: number): string
	return n .. " %"
end

local function num(v: number): string
	return (string.gsub(tostring(v), "%.", ","))
end

local function enemyTip(e, extra: string?): string
	local w = e.def.weapon
	return string.format(
		'<font size="17"><b>%s</b></font>\nLebenspunkte  <b>%d / %d</b>\n%s  <b>%d–%d</b> · Reichweite %s\nBewegung  %d Felder%s',
		e.name, e.hp, e.maxHp, w.name, w.min, w.max, num(w.range), e.move, extra or ""
	)
end

local lastPointer = Vector2.zero

applyHover = function(hit)
	local b = App.board
	if not b then
		return
	end
	if hit and hit.unit and not hit.unit.alive then
		hit = { tile = hit.tile, unit = nil }
	end
	b:clearDots()
	b:hideShields()
	b:clearDanger()
	b:setHover(nil)
	for _, vu in pairs(VU) do
		vu.nameLbl.Visible = vu.unit.def.boss == true or (hit ~= nil and hit.unit == vu.unit)
	end
	if App.mode == "move" then
		clearChances()
	end
	if not hit or App.phase ~= "player" or App.busy then
		ui:hideTip()
		return
	end
	local G, h, u, t = App.G, App.selected, hit.unit, hit.tile
	if t then
		b:setHover(t.x, t.z)
	end
	if u and u.team == "enemy" then
		if App.mode ~= "attack" then
			local dist = G:bfs(u, u.x, u.z, u.move)
			for k in pairs(dist) do
				local x, z = Rules.unkey(k)
				if not (x == u.x and z == u.z) then
					b:setDanger(x, z)
				end
			end
		end
		local extra = ""
		if h and App.mode == "attack" then
			local info = G:shotInfo(h, h.x, h.z, u)
			local w = h.def.weapon
			local c = if info.chance >= 100 then "#5fd068" elseif info.chance > 0 then "#ffc63d" else "#ff5a5a"
			extra = string.format('\n<font color="#b9add6">────────────</font>\nTrefferchance  <font size="19" color="%s"><b>%s</b></font>\n%s', c, if info.inRange then pct(info.chance) else "–", info.reason)
			if u.status.shield then
				extra ..= " · Schild"
			end
			if info.chance > 0 then
				extra ..= string.format("\nSchaden  <b>%d–%d</b>", w.min, w.max)
				if w.effect then
					extra ..= string.format("\n%s  %s%s", Config.EFFECT_NAMES[w.effect], pct(math.round(w.chance * 100)), if u.def.boss and w.effect == "push" then " (immun)" else "")
				end
			end
		elseif h and App.mode == "move" and App.moveOpts then
			local k, o = key(u.x, u.z), App.moveOpts
			if o.dash[k] then
				extra = string.format('\n<font color="#ff8a2a"><b>Sprintangriff</b></font>  %d Schaden', h.def.dash)
				local st = o.dash[k].stand
				b:drawPath(G:findPath(h, st.x, st.z))
			elseif o.stomp[k] then
				local s = o.stomp[k]
				extra = string.format('\n<font color="#ff5fd2"><b>Sprungangriff über %s</b></font>  %d Schaden', s.via.name, Config.STOMP_DMG)
				b:drawPath(G:findPath(h, s.via.x, s.via.z))
				b:drawArc(tp(s.via.x, s.via.z), tp(u.x, u.z, 3))
			end
		end
		ui:showTip(enemyTip(u, extra), lastPointer.X, lastPointer.Y)
		return
	end
	if u and u.team == "hero" then
		ui:showTip(string.format('<font size="17"><b>%s</b></font>\nLebenspunkte  <b>%d / %d</b>%s', u.name, u.hp, u.maxHp, if u ~= h then "\nKlicken zum Auswählen" else ""), lastPointer.X, lastPointer.Y)
		return
	end
	if not h or not t then
		ui:hideTip()
		return
	end
	if App.mode == "move" and App.moveOpts then
		local k, o = key(t.x, t.z), App.moveOpts
		local title = nil
		if o.walk[k] and not (t.x == h.x and t.z == h.z) then
			b:drawPath(G:findPath(h, t.x, t.z))
			title = "Laufen"
		elseif o.jump[k] then
			local j = o.jump[k]
			b:drawPath(G:findPath(h, j.via.x, j.via.z))
			b:drawArc(tp(j.via.x, j.via.z), tp(t.x, t.z))
			title = "Teamsprung über " .. j.via.name
		end
		if title then
			b:showShields(t.x, t.z, Rules.coverVal)
			for _, e in ipairs(G:foes()) do
				local info = G:shotInfo(h, t.x, t.z, e)
				if info.inRange and VU[e.id] then
					showChance(VU[e.id], info.chance)
				end
			end
			local best = 0
			for _, d in ipairs(Rules.DIRS) do
				best = math.max(best, Rules.coverVal(G:tileAt(t.x + d[1], t.z + d[2])))
			end
			ui:showTip(string.format('<font size="17"><b>%s</b></font>\nDeckung hier  <b>%s</b>\n<font color="#b9add6">Zahlen über Gegnern: Trefferchance von hier</font>', title, ({ "keine", "halb", "voll" })[best + 1]), lastPointer.X, lastPointer.Y)
			return
		end
	end
	ui:hideTip()
end

-- ------------------------------------------------------------------ HUD refresh

local function refreshUi()
	if not ui or not App.G then
		return
	end
	local G = App.G
	local playing = App.phase == "player" and not App.busy
	local data = {}
	for _, u in ipairs(G:heroList()) do
		local vu = VU[u.id]
		table.insert(data, {
			hp = if vu then vu.hp else u.hp,
			maxHp = u.maxHp,
			alive = if vu then vu.alive else u.alive,
			moved = u.moved,
			attacked = u.attacked,
			techReady = not u.techUsed and u.cd == 0,
			cd = u.cd,
			selected = App.selected == u and App.phase == "player",
		})
	end
	ui:setHeroes(data)
	local h = App.selected
	if h and not h.alive then
		h = nil
	end
	local allSpent = #G:heroes() > 0
	for _, u in ipairs(G:heroes()) do
		if not (u.moved and u.attacked) then
			allSpent = false
		end
	end
	local techLabel = "Technik [T]"
	if h then
		techLabel = if App.mode == "tech" then "Einsetzen [T]" else h.def.tech.name .. (if h.cd > 0 then " (" .. h.cd .. ")" else "")
	end
	ui:setActions({
		move = playing and h ~= nil and not h.moved,
		attack = playing and h ~= nil and not h.attacked,
		tech = playing and h ~= nil and not h.techUsed and h.cd == 0,
		endTurn = playing,
		mode = if playing then App.mode else nil,
		techLabel = techLabel,
		pulse = playing and allSpent,
	})
	if not h then
		ui:setInfo(if App.phase == "enemy" then '<font size="18"><b>Die Krawallos sind dran</b></font>' else '<font size="18"><b>Wähle einen Helden</b></font>')
		return
	end
	local w, t = h.def.weapon, h.def.tech
	local tState = if h.techUsed then "eingesetzt" elseif h.cd > 0 then "bereit in " .. h.cd .. (if h.cd == 1 then " Runde" else " Runden") else "bereit"
	ui:setInfo(string.format(
		'<font size="19" color="%s"><b>%s</b></font>  <font color="#b9add6">%s · %d Felder</font>\n<font color="#ffc63d"><b>WAFFE</b></font>  %s · %d–%d Schaden · Reichweite %s · %s %s\n<font color="#ffc63d"><b>TECHNIK</b></font>  %s (%s): %s\n<font color="#ffc63d"><b>SPRINT</b></font>  %d Schaden · %s',
		h.def.color, h.name, h.def.role, h.move,
		w.name, w.min, w.max, num(w.range), Config.EFFECT_NAMES[w.effect], pct(math.round(w.chance * 100)),
		t.name, tState, t.desc,
		h.def.dash, if h.dashUsed then "schon benutzt" else "einmal pro Zug"
	))
end

-- ------------------------------------------------------------------ flow

local finish
local selectHero

local function checkEnd(): boolean
	if App.phase == "over" or App.phase == "title" then
		return true
	end
	local r = App.G:result()
	if r then
		finish(r == "win")
		return true
	end
	return false
end

local function postAction()
	local G = App.G
	local h = App.selected
	if not h or not h.alive or G:heroDone(h) then
		for _, u in ipairs(G:heroes()) do
			if not G:heroDone(u) then
				h = u
				break
			end
		end
	end
	if h and h.alive then
		App.selected = h
		App.mode = defaultMode(h)
		focus(tp(h.x, h.z))
	end
	refreshHighlights()
	refreshUi()
	local allDone = true
	for _, u in ipairs(G:heroes()) do
		if not G:heroDone(u) then
			allDone = false
		end
	end
	if allDone then
		local run = App.run
		task.delay(0.9, function()
			if run == App.run and App.phase == "player" and not App.busy then
				App.endTurn()
			end
		end)
	end
end

local function act(fn: () -> { any })
	if App.busy or App.phase ~= "player" or App.paused then
		return
	end
	App.busy = true
	App.touchPending = nil
	ui:hideTip()
	refreshHighlights()
	refreshUi()
	local run = App.run
	task.spawn(function()
		local ok, events = pcall(fn)
		if not ok then
			warn("Krawall: Aktion fehlgeschlagen: " .. tostring(events))
			events = {}
		end
		play(events)
		if run ~= App.run then
			return
		end
		syncVisuals()
		App.busy = false
		if checkEnd() then
			return
		end
		postAction()
	end)
end

selectHero = function(u)
	if not u or not u.alive then
		return
	end
	if App.selected ~= u then
		Fx.sound("select")
	end
	App.selected = u
	App.touchPending = nil
	App.mode = defaultMode(u)
	focus(tp(u.x, u.z))
	refreshHighlights()
	refreshUi()
end

local function setMode(m: string?)
	App.mode = m
	refreshHighlights()
	refreshUi()
end

function App.endTurn()
	if App.phase ~= "player" or App.busy or App.paused then
		return
	end
	App.phase = "enemy"
	App.busy = true
	App.mode = nil
	App.hover = nil
	ui:hideTip()
	clearHighlights()
	refreshUi()
	local run = App.run
	task.spawn(function()
		local events = App.G:endTurn()
		play(events)
		if run ~= App.run then
			return
		end
		syncVisuals()
		App.busy = false
		if checkEnd() then
			return
		end
		App.phase = "player"
		local sel = if App.selected and App.selected.alive then App.selected else App.G:heroes()[1]
		App.selected = nil
		selectHero(sel)
	end)
end

local function frameCamera()
	local G = App.G
	local span = math.max(G.W, G.H) * TILE
	local vp = camera.ViewportSize
	local aspect = vp.X / math.max(1, vp.Y)
	goal.yaw = 0
	goal.pitch = 0.95
	goal.dist = span * (if aspect < 1.2 then 1.75 else 1.38)
	goal.target = Vector3.new(0, 0, span * 0.1)
	cam.yaw, cam.pitch, cam.dist, cam.target = goal.yaw, goal.pitch, goal.dist, goal.target
end

local function buildBattlefield(li: number)
	if App.board then
		App.board:destroy()
	end
	table.clear(VU)
	Fx.clear()
	App.li = li
	App.G = Rules.new(Config, li, function()
		return rnd:NextNumber()
	end)
	App.board = Board.new(App.G, world)
	for _, u in ipairs(App.G.units) do
		makeVisual(u)
	end
	frameCamera()
end

local function enemyCounts()
	local out = {}
	for i, L in ipairs(Config.LEVELS) do
		local n = 0
		for _, rowStr in ipairs(L.map) do
			for c in string.gmatch(rowStr, ".") do
				if Config.ENEMY_CODES[c] then
					n += 1
				end
			end
		end
		out[i] = n
	end
	return out
end
local ENEMY_COUNTS = enemyCounts()

local function showTitle()
	App.run += 1
	App.phase = "title"
	App.busy = false
	App.paused = false
	Fx.speed = App.speed
	App.selected = nil
	App.mode = nil
	App.hover = nil
	App.pick = math.min(progress.won + 1, #Config.LEVELS)
	buildBattlefield(App.pick)
	ui:setHudVisible(false)
	ui:hideTip()
	ui:setLevels(Config.LEVELS, progress.won, progress.best, App.pick, ENEMY_COUNTS)
	ui:show("title")
end

local function startLevel(li: number)
	App.run += 1
	App.paused = false
	Fx.speed = App.speed
	buildBattlefield(li)
	App.phase = "player"
	App.busy = true
	App.selected = nil
	App.mode = nil
	App.hover = nil
	ui:setLevel(li, App.G.level)
	ui:buildHeroCards(App.G:heroList())
	ui:show(nil)
	ui:setHudVisible(true)
	refreshUi()
	local run = App.run
	task.spawn(function()
		play(App.G:startPlayerTurn(true))
		if run ~= App.run then
			return
		end
		syncVisuals()
		App.busy = false
		selectHero(App.G:heroes()[1])
	end)
end

finish = function(won: boolean)
	App.phase = "over"
	App.busy = false
	App.mode = nil
	clearHighlights()
	refreshUi()
	ui:hideTip()
	local run = App.run
	task.delay(0.9, function()
		if run ~= App.run then
			return
		end
		Fx.sound(if won then "win" else "lose")
		local G, li = App.G, App.li
		local L = G.level
		local final = won and li == #Config.LEVELS
		local rating
		local unlockText = nil
		if won then
			local score = 1 + (if G.turn <= L.par then 1 else 0) + (if G.stats.kos == 0 then 1 else 0)
			rating = ({ "Bewertung: Geschafft", "Bewertung: Stark", "Bewertung: Meisterhaft" })[score] .. " · Ziel war " .. L.par .. " Runden"
			local prev = progress.best[tostring(li)]
			if not prev or score > prev.score or (score == prev.score and G.turn < prev.turn) then
				progress.best[tostring(li)] = { score = score, turn = G.turn }
			end
			if li > progress.won then
				progress.won = li
				local names = {}
				for _, entry in ipairs(Skins.unlockedBy(li)) do
					table.insert(names, entry.skin.name .. " (" .. Config.HEROES[entry.hero].name .. ")")
				end
				if #names > 0 then
					unlockText = "<b>Neue Skins freigeschaltet:</b> " .. table.concat(names, ", ") .. ". Rüste sie in der Garderobe aus."
				end
			end
			saveProgress()
			if final then
				rating ..= " · Der Krawall-König ist gestürzt."
			end
		else
			rating = "Alle Helden sind K.O. Versuch es mit mehr Deckung und Teamsprüngen."
		end
		local acc = if G.stats.shots > 0 then math.round(100 * G.stats.hits / G.stats.shots) else 0
		local buttons = {}
		if won and not final then
			table.insert(buttons, { "Nächster Kampf", "gold", function()
				startLevel(li + 1)
			end })
		elseif not won then
			table.insert(buttons, { "Nochmal versuchen", "gold", function()
				startLevel(li)
			end })
		end
		if unlockText then
			table.insert(buttons, { "Garderobe", if final then "gold" else "violet", function()
				App.skinsReturn = "ending"
				ui:openSkins(Skins, progress)
			end })
		end
		if final then
			table.insert(buttons, { "Nochmal von vorn", "violet", function()
				startLevel(1)
			end })
		end
		table.insert(buttons, { "Hauptmenü", "violet", showTitle })
		ui:showEnd({
			eyebrow = "KAMPF " .. li .. " · " .. string.upper(L.name),
			title = if final then "Königreich gerettet!" elseif won then "Sieg!" else "Niederlage",
			won = won,
			rating = rating,
			stats = { { "RUNDEN", tostring(G.turn) }, { "TREFFERQUOTE", pct(acc) }, { "SCHADEN", tostring(G.stats.dealt) }, { "HELDEN K.O.", tostring(G.stats.kos) } },
			unlock = unlockText,
			buttons = buttons,
		})
	end)
end

-- ------------------------------------------------------------------ board clicks

local function onBoardClick(hit, isTouch: boolean)
	if App.phase ~= "player" or App.busy or App.paused or not hit then
		return
	end
	local G, h, u, t = App.G, App.selected, hit.unit, hit.tile
	if isTouch then
		local k = hitKey(hit)
		local immediate = u ~= nil and u.team == "hero" and u ~= h and App.mode ~= "tech"
		if not immediate and App.touchPending ~= k then
			App.touchPending = k
			App.hover = hit
			applyHover(hit)
			return
		end
		App.touchPending = nil
	end
	if u and u.team == "hero" and App.mode ~= "tech" then
		if u ~= h then
			selectHero(u)
		end
		return
	end
	if not h or not h.alive then
		return
	end
	if App.mode == "move" and App.moveOpts then
		local o = App.moveOpts
		if u and u.team == "enemy" then
			local k = key(u.x, u.z)
			if o.dash[k] then
				local d = o.dash[k]
				act(function()
					return G:heroDash(h, d)
				end)
			elseif o.stomp[k] then
				local s = o.stomp[k]
				act(function()
					return G:heroStomp(h, s)
				end)
			end
			return
		end
		if not t then
			return
		end
		local k = key(t.x, t.z)
		if o.walk[k] and not (t.x == h.x and t.z == h.z) then
			act(function()
				return G:heroWalk(h, t.x, t.z)
			end)
		elseif o.jump[k] then
			local j = o.jump[k]
			act(function()
				return G:heroJump(h, j)
			end)
		end
		return
	end
	if App.mode == "attack" then
		if u and u.team == "enemy" and not h.attacked then
			local info = G:shotInfo(h, h.x, h.z, u)
			if info.chance > 0 then
				act(function()
					return G:heroAttack(h, u)
				end)
			elseif VU[u.id] then
				Fx.floatText(unitTop(VU[u.id], 1.6), info.reason, "miss")
			end
		elseif not u and not h.moved then
			setMode("move")
		end
		return
	end
	if App.mode == "tech" then
		local area = G:techArea(h)
		local inArea = false
		if t then
			for _, p in ipairs(area) do
				if p[1] == t.x and p[2] == t.z then
					inArea = true
				end
			end
		end
		if inArea then
			act(function()
				return G:heroTech(h)
			end)
		else
			setMode(defaultMode(h))
		end
	end
end

-- ------------------------------------------------------------------ UI handlers

local function useTech()
	local h = App.selected
	if App.phase ~= "player" or App.busy or not h or h.techUsed or h.cd > 0 then
		return
	end
	if App.mode == "tech" then
		act(function()
			return App.G:heroTech(h)
		end)
	else
		setMode("tech")
	end
end

local function openPause()
	if App.phase == "title" or App.phase == "over" or ui.current ~= nil then
		return
	end
	App.paused = true
	Fx.speed = 0
	ui:hideTip()
	ui:showPause(string.format("Kampf %d · %s, Runde %d. Gegner übrig: %d.", App.li, App.G.level.name, App.G.turn, #App.G:foes()))
end

local function resume()
	App.paused = false
	Fx.speed = App.speed
	ui:show(nil)
end

ui = Ui.new({
	onPlay = function()
		startLevel(App.pick)
	end,
	onPickLevel = function(i: number)
		App.pick = i
		buildBattlefield(i)
		ui:setLevels(Config.LEVELS, progress.won, progress.best, App.pick, ENEMY_COUNTS)
	end,
	onOpenSkins = function()
		App.skinsReturn = ui.current or "title"
		ui:openSkins(Skins, progress)
	end,
	onCloseSkins = function()
		ui:show(App.skinsReturn or "title")
	end,
	onEquip = function(heroKind: string, id: string)
		if Skins.isUnlocked(heroKind, id, progress.won) then
			progress.skins[heroKind] = id
			saveProgress()
			reskin(heroKind)
			ui:refreshSkins()
		end
	end,
	onHelp = function()
		App.helpReturn = ui.current
		if App.helpReturn == nil and (App.phase == "player" or App.phase == "enemy") then
			App.paused = true
			Fx.speed = 0
		end
		ui:show("help")
	end,
	onCloseHelp = function()
		ui:show(App.helpReturn)
		if App.helpReturn == nil then
			App.paused = false
			Fx.speed = App.speed
		end
	end,
	onPause = openPause,
	onResume = resume,
	onRestart = function()
		startLevel(App.li)
	end,
	onToTitle = showTitle,
	onSpeed = function()
		App.speed = if App.speed >= 3 then 1 else App.speed + 1
		if not App.paused then
			Fx.speed = App.speed
		end
		ui.speedBtn:setText(App.speed .. "×")
	end,
	onSound = function()
		Fx.muted = not Fx.muted
		ui.soundBtn:setText(if Fx.muted then "Stumm" else "Ton")
	end,
	onSelectHero = function(i: number)
		if App.phase == "player" and not App.busy and not App.paused then
			local u = App.G:heroList()[i]
			if u and u.alive then
				selectHero(u)
			end
		end
	end,
	onMode = function(m: string)
		local h = App.selected
		if App.phase ~= "player" or App.busy or not h then
			return
		end
		if m == "move" and not h.moved then
			setMode("move")
		elseif m == "attack" and not h.attacked then
			setMode("attack")
		end
	end,
	onTech = useTech,
	onEndTurn = function()
		App.endTurn()
	end,
})
ui.refresh = function()
	refreshUi()
end

-- ------------------------------------------------------------------ input

local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Include

local function pick(x: number, y: number)
	if not App.board or not App.G then
		return nil
	end
	rayParams.FilterDescendantsInstances = { App.board.folder }
	local ray = camera:ScreenPointToRay(x, y)
	local res = workspace:Raycast(ray.Origin, ray.Direction * 800, rayParams)
	if not res then
		return nil
	end
	local inst = res.Instance
	local uid = inst:GetAttribute("UnitId")
	if uid then
		local u = App.G.byId[uid]
		if u and u.alive then
			return { unit = u, tile = App.G:tileAt(u.x, u.z) }
		end
		return nil
	end
	local tx, tz = inst:GetAttribute("TX"), inst:GetAttribute("TZ")
	if tx ~= nil and tz ~= nil then
		return { tile = App.G:tileAt(tx, tz), unit = App.G:unitAt(tx, tz) }
	end
	return nil
end

local function rotateBy(delta: Vector2)
	goal.yaw -= delta.X * 0.006
	goal.pitch = math.clamp(goal.pitch + delta.Y * 0.004, 0.42, 1.38)
end

local function panBy(delta: Vector2)
	local s = cam.dist * 0.0016
	local fwd = Vector3.new(-math.sin(cam.yaw), 0, -math.cos(cam.yaw))
	local right = Vector3.new(math.cos(cam.yaw), 0, -math.sin(cam.yaw))
	goal.target += right * (-delta.X * s) + fwd * (delta.Y * s)
end

-- Liegt der Mauszeiger über einem sichtbaren HUD-Element?
local function overHud(p: Vector2): boolean
	for _, g in ipairs(player.PlayerGui:GetGuiObjectsAtPosition(p.X, p.Y)) do
		if g:IsDescendantOf(ui.hud) and g ~= ui.tip and not g:IsDescendantOf(ui.tip) and (g.BackgroundTransparency < 1 or g:IsA("GuiButton")) then
			return true
		end
	end
	return false
end

local drag = nil
local keysDown = {}
local pinchStart = nil

local KEY_ACTIONS = {
	[Enum.KeyCode.Q] = function()
		goal.yaw += math.pi / 4
	end,
	[Enum.KeyCode.E] = function()
		goal.yaw -= math.pi / 4
	end,
	[Enum.KeyCode.L] = function()
		ui.h.onMode("move")
	end,
	[Enum.KeyCode.F] = function()
		ui.h.onMode("attack")
	end,
	[Enum.KeyCode.T] = useTech,
	[Enum.KeyCode.Return] = function()
		App.endTurn()
	end,
	[Enum.KeyCode.P] = function()
		if App.paused and ui.current == "pause" then
			resume()
		else
			openPause()
		end
	end,
	[Enum.KeyCode.H] = function()
		if ui.current == "help" then
			ui.h.onCloseHelp()
		elseif ui.current == nil and App.phase ~= "title" then
			ui.h.onHelp()
		end
	end,
	[Enum.KeyCode.X] = function()
		local h = App.selected
		if App.phase == "player" and not App.busy and h then
			setMode(defaultMode(h))
		end
	end,
}

local function cycleHero(dir: number)
	if App.phase ~= "player" or App.busy or App.paused then
		return
	end
	local list = App.G:heroes()
	if #list == 0 then
		return
	end
	local idx = table.find(list, App.selected) or 0
	selectHero(list[((idx - 1 + dir) % #list) + 1])
end

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	local t = input.UserInputType
	if t == Enum.UserInputType.Keyboard then
		if processed and input.KeyCode ~= Enum.KeyCode.Tab then
			return
		end
		local kc = input.KeyCode
		keysDown[kc] = true
		if App.phase == "title" or ui.current ~= nil and ui.current ~= "pause" and ui.current ~= "help" then
			return
		end
		if kc == Enum.KeyCode.One or kc == Enum.KeyCode.Two or kc == Enum.KeyCode.Three then
			local idx = if kc == Enum.KeyCode.One then 1 elseif kc == Enum.KeyCode.Two then 2 else 3
			ui.h.onSelectHero(idx)
		elseif kc == Enum.KeyCode.Tab or kc == Enum.KeyCode.N then
			cycleHero(1)
		elseif KEY_ACTIONS[kc] then
			if ui.current ~= nil and kc ~= Enum.KeyCode.P and kc ~= Enum.KeyCode.H then
				return
			end
			KEY_ACTIONS[kc]()
		end
		return
	end
	if processed then
		return
	end
	if t == Enum.UserInputType.MouseButton1 or t == Enum.UserInputType.MouseButton2 or t == Enum.UserInputType.MouseButton3 then
		local p = Vector2.new(input.Position.X, input.Position.Y)
		drag = { start = p, last = p, button = t, moved = false, touch = false }
	elseif t == Enum.UserInputType.Touch then
		local p = Vector2.new(input.Position.X, input.Position.Y)
		if drag == nil then
			drag = { start = p, last = p, button = t, moved = false, touch = true, input = input }
		else
			drag.moved = true -- zweiter Finger: kein Tippen mehr
		end
	end
end)

UserInputService.InputChanged:Connect(function(input: InputObject, processed: boolean)
	local t = input.UserInputType
	if t == Enum.UserInputType.MouseMovement then
		local p = Vector2.new(input.Position.X, input.Position.Y)
		lastPointer = p
		if drag and not drag.touch then
			local delta = p - drag.last
			if not drag.moved and (p - drag.start).Magnitude > 6 then
				drag.moved = true
			end
			if drag.moved then
				local shift = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
				if drag.button == Enum.UserInputType.MouseButton3 or shift then
					panBy(delta)
				else
					rotateBy(delta)
				end
				ui:hideTip()
			end
			drag.last = p
			return
		end
		if processed or overHud(p) then
			if App.hover then
				App.hover = nil
				applyHover(nil)
			end
			return
		end
		local hit = pick(p.X, p.Y)
		if hitKey(hit) ~= hitKey(App.hover) then
			App.hover = hit
			applyHover(hit)
		elseif ui.tip.Visible then
			ui:showTip(ui.tipLabel.Text, p.X, p.Y)
		end
	elseif t == Enum.UserInputType.MouseWheel then
		if not processed then
			goal.dist = math.clamp(goal.dist * math.exp(-input.Position.Z * 0.12), 22, 170)
		end
	elseif t == Enum.UserInputType.Touch then
		if drag and drag.touch and drag.input == input then
			local p = Vector2.new(input.Position.X, input.Position.Y)
			if not drag.moved and (p - drag.start).Magnitude > 10 then
				drag.moved = true
			end
			if drag.moved and pinchStart == nil then
				rotateBy(p - drag.last)
			end
			drag.last = p
		end
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject, _processed: boolean)
	local t = input.UserInputType
	if t == Enum.UserInputType.Keyboard then
		keysDown[input.KeyCode] = nil
		return
	end
	if drag and not drag.touch and drag.button == t then
		local wasDrag = drag
		drag = nil
		if not wasDrag.moved and t == Enum.UserInputType.MouseButton1 then
			onBoardClick(pick(input.Position.X, input.Position.Y), false)
		end
	elseif t == Enum.UserInputType.Touch and drag and drag.touch and drag.input == input then
		local wasDrag = drag
		drag = nil
		if not wasDrag.moved then
			lastPointer = Vector2.new(input.Position.X, input.Position.Y)
			onBoardClick(pick(input.Position.X, input.Position.Y), true)
		end
	end
end)

UserInputService.TouchPinch:Connect(function(_positions, scale: number, _velocity, state: Enum.UserInputState, processed: boolean)
	if processed then
		return
	end
	if state == Enum.UserInputState.Begin then
		pinchStart = goal.dist
		if drag then
			drag.moved = true
		end
	elseif state == Enum.UserInputState.Change and pinchStart then
		goal.dist = math.clamp(pinchStart / math.max(0.2, scale), 22, 170)
	else
		pinchStart = nil
	end
end)

-- ------------------------------------------------------------------ camera & frame loop

RunService:BindToRenderStep("KrawallKamera", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
	camera.CameraType = Enum.CameraType.Scriptable
	if App.phase == "title" then
		goal.yaw += dt * 0.07
	end
	local pan = 40 * dt
	local fwd = Vector3.new(-math.sin(cam.yaw), 0, -math.cos(cam.yaw))
	local right = Vector3.new(math.cos(cam.yaw), 0, -math.sin(cam.yaw))
	if keysDown[Enum.KeyCode.W] or keysDown[Enum.KeyCode.Up] then
		goal.target += fwd * pan
	end
	if keysDown[Enum.KeyCode.S] or keysDown[Enum.KeyCode.Down] then
		goal.target -= fwd * pan
	end
	if keysDown[Enum.KeyCode.A] or keysDown[Enum.KeyCode.Left] then
		goal.target -= right * pan
	end
	if keysDown[Enum.KeyCode.D] or keysDown[Enum.KeyCode.Right] then
		goal.target += right * pan
	end
	if App.G then
		local hw, hh = App.G.W * TILE / 2, App.G.H * TILE / 2
		goal.target = Vector3.new(math.clamp(goal.target.X, -hw, hw), 0, math.clamp(goal.target.Z, -hh, hh))
	end
	local f = 1 - math.exp(-dt * 7)
	cam.yaw += (goal.yaw - cam.yaw) * f
	cam.pitch += (goal.pitch - cam.pitch) * f
	cam.dist += (goal.dist - cam.dist) * f
	cam.target = cam.target:Lerp(goal.target, f * 0.8)
	local cp = math.cos(cam.pitch)
	local pos = cam.target + Vector3.new(cam.dist * cp * math.sin(cam.yaw), cam.dist * math.sin(cam.pitch), cam.dist * cp * math.cos(cam.yaw))
	if Fx.shakeAmount > 0.01 then
		pos += Vector3.new((rnd:NextNumber() - 0.5) * Fx.shakeAmount, (rnd:NextNumber() - 0.5) * Fx.shakeAmount, 0)
	end
	camera.CFrame = CFrame.lookAt(pos, cam.target)
	camera.FieldOfView = 45
end)

RunService.RenderStepped:Connect(function(dt: number)
	Fx.update(dt)
	if App.board then
		updateVisuals(dt, os.clock())
	end
end)

-- ------------------------------------------------------------------ start

loadProgress()
ui.soundBtn:setText("Ton")
showTitle()
]]></string>
        </Properties>
        <Item class="ModuleScript" referent="13">
          <Properties>
            <string name="Name">Board</string>
            <string name="Source"><![CDATA[-- Spielfeld-Darstellung: Bodenfelder, Mauern, Kisten, Markierungen (Laufen, Teamsprung, Reichweite, Gefahr),
-- Deckungsanzeige, Reichweitenkreis, Deko-Inseln und Beleuchtung je Level.

local Lighting = game:GetService("Lighting")

local Board = {}
Board.__index = Board

local TILE = 4

local function hex(c: string): Color3
	return Color3.fromHex(c)
end

local function newPart(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanTouch = false
	p.CanQuery = false
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function key(x: number, z: number): number
	return x * 1000 + z
end

local OVERLAY = {
	move = { "#3fa8ff", 0.35 },
	jump = { "#ffc63d", 0.3 },
	range = { "#ff5a4a", 0.72 },
	area = { "#5ee3d2", 0.5 },
}

function Board.new(G, parent: Instance)
	local self = setmetatable({}, Board)
	self.G = G
	self.W = G.W
	self.H = G.H
	self.theme = G.level.theme
	self.folder = Instance.new("Folder")
	self.folder.Name = "Spielfeld"
	self.folder.Parent = parent
	self.tops = {}
	self.covers = {}
	self.overlays = {}
	self.dangers = {}
	self.shownOverlays = {}
	self.shownDangers = {}
	self:buildTiles()
	self:buildMarkers()
	self:buildDecor()
	self:applyLighting()
	return self
end

function Board:tilePos(x: number, z: number, y: number?): Vector3
	return Vector3.new((x - self.W / 2 + 0.5) * TILE, y or 0, (z - self.H / 2 + 0.5) * TILE)
end

function Board:destroy()
	self.folder:Destroy()
end

-- ------------------------------------------------------------------ tiles & cover

function Board:buildTiles()
	local th = self.theme
	local cA, cB, side = hex(th.a), hex(th.b), hex(th.side)
	local floorMat = if th.floor == "stone" then Enum.Material.Cobblestone else Enum.Material.Grass
	for z = 0, self.H - 1 do
		for x = 0, self.W - 1 do
			local t = self.G:tileAt(x, z)
			if t.type ~= "water" then
				local pos = self:tilePos(x, z)
				local top = newPart(self.folder, Vector3.new(TILE - 0.08, 1, TILE - 0.08), CFrame.new(pos + Vector3.new(0, -0.5, 0)), if (x + z) % 2 == 0 then cA else cB, floorMat)
				local base = newPart(self.folder, Vector3.new(TILE - 0.08, 7, TILE - 0.08), CFrame.new(pos + Vector3.new(0, -4.5, 0)), side, Enum.Material.Ground)
				for _, p in ipairs({ top, base }) do
					p.CanQuery = true
					p:SetAttribute("TX", x)
					p:SetAttribute("TZ", z)
				end
				self.tops[key(x, z)] = top
				if t.type == "wall" then
					self:buildWall(x, z, pos)
				elseif t.type == "low" then
					self:buildCrate(x, z, pos)
				end
			end
		end
	end
end

function Board:buildWall(x: number, z: number, pos: Vector3)
	local wall = newPart(self.folder, Vector3.new(3.6, 6, 3.6), CFrame.new(pos + Vector3.new(0, 3, 0)) * CFrame.Angles(0, ((x * 7 + z * 3) % 4) * math.pi / 2, 0), hex("#a79fb8"), Enum.Material.Brick)
	local cap = newPart(self.folder, Vector3.new(3.95, 0.6, 3.95), CFrame.new(pos + Vector3.new(0, 6.3, 0)), hex("#8c84a0"), Enum.Material.Slate)
	for _, p in ipairs({ wall, cap }) do
		p.CanQuery = true
		p:SetAttribute("TX", x)
		p:SetAttribute("TZ", z)
	end
	self.covers[key(x, z)] = { wall, cap }
end

function Board:buildCrate(x: number, z: number, pos: Vector3)
	local yaw = (((x * 5 + z * 11) % 7) - 3) * 0.06
	local base = CFrame.new(pos) * CFrame.Angles(0, yaw, 0)
	local parts = {}
	local body = newPart(self.folder, Vector3.new(3.1, 2.6, 3.1), base * CFrame.new(0, 1.3, 0), hex("#c98a4b"), Enum.Material.WoodPlanks)
	body.CanQuery = true
	body:SetAttribute("TX", x)
	body:SetAttribute("TZ", z)
	table.insert(parts, body)
	local frame = hex("#7a4524")
	for _, cx in ipairs({ -1.45, 1.45 }) do
		for _, cz in ipairs({ -1.45, 1.45 }) do
			table.insert(parts, newPart(self.folder, Vector3.new(0.4, 2.7, 0.4), base * CFrame.new(cx, 1.35, cz), frame, Enum.Material.Wood))
		end
	end
	table.insert(parts, newPart(self.folder, Vector3.new(0.35, 0.35, 3.9), base * CFrame.new(0, 1.3, -1.58) * CFrame.Angles(0, math.rad(90), math.rad(40)), frame, Enum.Material.Wood))
	table.insert(parts, newPart(self.folder, Vector3.new(0.35, 0.35, 3.9), base * CFrame.new(0, 1.3, 1.58) * CFrame.Angles(0, math.rad(90), math.rad(-40)), frame, Enum.Material.Wood))
	self.covers[key(x, z)] = parts
end

-- Kiste getroffen oder zerstört; liefert die Mitte für Effekte
function Board:crateHit(x: number, z: number, destroyed: boolean): Vector3
	local parts = self.covers[key(x, z)]
	local center = self:tilePos(x, z, 1.4)
	if not parts then
		return center
	end
	if destroyed then
		for _, p in ipairs(parts) do
			p:Destroy()
		end
		self.covers[key(x, z)] = nil
	else
		for _, p in ipairs(parts) do
			p.CFrame = CFrame.new(center) * CFrame.Angles(0, 0, 0.12) * CFrame.new(-center) * p.CFrame
			p.Color = p.Color:Lerp(Color3.new(0, 0, 0), 0.25)
		end
	end
	return center
end

-- ------------------------------------------------------------------ markers

function Board:buildMarkers()
	for z = 0, self.H - 1 do
		for x = 0, self.W - 1 do
			if self.G:tileAt(x, z).type ~= "water" then
				local pos = self:tilePos(x, z)
				local o = newPart(self.folder, Vector3.new(3.5, 0.08, 3.5), CFrame.new(pos + Vector3.new(0, 0.06, 0)), Color3.new(1, 1, 1))
				o.Transparency = 1
				o.CastShadow = false
				self.overlays[key(x, z)] = o
				local d = newPart(self.folder, Vector3.new(2.2, 0.08, 2.2), CFrame.new(pos + Vector3.new(0, 0.1, 0)), hex("#ff3d6e"))
				d.Transparency = 1
				d.CastShadow = false
				self.dangers[key(x, z)] = d
			end
		end
	end
	-- Hover-Rahmen aus vier Leuchtleisten
	self.hoverBars = {}
	for i = 1, 4 do
		local b = newPart(self.folder, Vector3.new(3.9, 0.12, 0.22), CFrame.new(), Color3.new(1, 1, 1), Enum.Material.Neon)
		b.CastShadow = false
		b.Transparency = 1
		self.hoverBars[i] = b
	end
	self.dots = {}
	self.dotsUsed = 0
	self.shields = {}
	for i = 1, 4 do
		local s = newPart(self.folder, Vector3.new(2.6, 1.2, 0.22), CFrame.new(), hex("#ffc63d"), Enum.Material.Neon)
		s.Transparency = 1
		s.CastShadow = false
		self.shields[i] = s
	end
	self.ring = {}
	for i = 1, 80 do
		local r = newPart(self.folder, Vector3.new(0.5, 0.1, 0.25), CFrame.new(), Color3.new(1, 1, 1), Enum.Material.Neon)
		r.Transparency = 1
		r.CastShadow = false
		self.ring[i] = r
	end
end

function Board:setOverlay(x: number, z: number, kind: string)
	local o = self.overlays[key(x, z)]
	local st = OVERLAY[kind]
	if not o or not st then
		return
	end
	o.Color = hex(st[1])
	o.Transparency = st[2]
	self.shownOverlays[key(x, z)] = true
end

function Board:clearOverlays()
	for k in pairs(self.shownOverlays) do
		self.overlays[k].Transparency = 1
	end
	table.clear(self.shownOverlays)
end

function Board:setDanger(x: number, z: number)
	local d = self.dangers[key(x, z)]
	if d then
		d.Transparency = 0.45
		self.shownDangers[key(x, z)] = true
	end
end

function Board:clearDanger()
	for k in pairs(self.shownDangers) do
		self.dangers[k].Transparency = 1
	end
	table.clear(self.shownDangers)
end

function Board:setHover(x: number?, z: number?)
	if x == nil or z == nil then
		for _, b in ipairs(self.hoverBars) do
			b.Transparency = 1
		end
		return
	end
	local c = self:tilePos(x, z, 0.12)
	local h = TILE / 2 - 0.08
	local cfs = {
		CFrame.new(c + Vector3.new(0, 0, -h)),
		CFrame.new(c + Vector3.new(0, 0, h)),
		CFrame.new(c + Vector3.new(-h, 0, 0)) * CFrame.Angles(0, math.rad(90), 0),
		CFrame.new(c + Vector3.new(h, 0, 0)) * CFrame.Angles(0, math.rad(90), 0),
	}
	for i, b in ipairs(self.hoverBars) do
		b.CFrame = cfs[i]
		b.Transparency = 0.05
	end
end

function Board:addDot(p: Vector3)
	self.dotsUsed += 1
	local d = self.dots[self.dotsUsed]
	if not d then
		d = newPart(self.folder, Vector3.new(0.4, 0.4, 0.4), CFrame.new(), Color3.new(1, 1, 1), Enum.Material.Neon, Enum.PartType.Ball)
		d.CastShadow = false
		self.dots[self.dotsUsed] = d
	end
	d.CFrame = CFrame.new(p)
	d.Transparency = 0
end

function Board:clearDots()
	for _, d in ipairs(self.dots) do
		d.Transparency = 1
	end
	self.dotsUsed = 0
end

function Board:drawPath(path)
	for _, p in ipairs(path) do
		self:addDot(self:tilePos(p[1], p[2], 0.45))
	end
end

function Board:drawArc(a: Vector3, b: Vector3)
	for i = 1, 9 do
		local k = i / 10
		local p = a:Lerp(b, k) + Vector3.new(0, math.sin(math.pi * k) * 8.5 + 0.45, 0)
		self:addDot(p)
	end
end

-- Deckungsanzeige am Feldrand: niedrig/gelb = halbe, hoch/grün = volle Deckung
function Board:showShields(x: number, z: number, coverVal: (any) -> number)
	local dirs = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }
	for i, d in ipairs(dirs) do
		local v = coverVal(self.G:tileAt(x + d[1], z + d[2]))
		local s = self.shields[i]
		if v == 0 then
			s.Transparency = 1
		else
			local h = if v == 2 then 2.4 else 1.2
			s.Size = Vector3.new(2.6, h, 0.22)
			s.Color = if v == 2 then hex("#5fd068") else hex("#ffc63d")
			local pos = self:tilePos(x, z, h / 2 + 0.1) + Vector3.new(d[1], 0, d[2]) * (TILE / 2 - 0.35)
			local rot = if d[1] ~= 0 then CFrame.Angles(0, math.rad(90), 0) else CFrame.new()
			s.CFrame = CFrame.new(pos) * rot
			s.Transparency = 0.25
		end
	end
end

function Board:hideShields()
	for _, s in ipairs(self.shields) do
		s.Transparency = 1
	end
end

function Board:showRange(x: number, z: number, radiusTiles: number, color: Color3)
	local c = self:tilePos(x, z, 0.14)
	local r = radiusTiles * TILE
	local n = #self.ring
	local seg = 2 * math.pi * r / n
	for i, p in ipairs(self.ring) do
		local a = (i - 0.5) / n * math.pi * 2
		p.Size = Vector3.new(seg + 0.05, 0.1, 0.28)
		p.CFrame = CFrame.new(c + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r)) * CFrame.Angles(0, -a + math.pi / 2, 0)
		p.Color = color
		p.Transparency = 0.15
	end
end

function Board:hideRange()
	for _, p in ipairs(self.ring) do
		p.Transparency = 1
	end
end

-- ------------------------------------------------------------------ decor

local function tree(parent: Instance, base: Vector3, s: number, rnd: Random)
	newPart(parent, Vector3.new(3.2, 0.5, 0.5) * s, CFrame.new(base + Vector3.new(0, 1.6 * s, 0)) * CFrame.Angles(0, 0, math.rad(90)), hex("#7a4a2a"), Enum.Material.Wood, Enum.PartType.Cylinder)
	local greens = { "#3f9b46", "#4fae4f", "#2f8a3f" }
	for i = 0, 2 do
		local d = (3.2 - i * 0.6) * s
		newPart(parent, Vector3.new(d, d, d), CFrame.new(base + Vector3.new((rnd:NextNumber() - 0.5) * 0.8 * s, (3.6 + i * 1.2) * s, (rnd:NextNumber() - 0.5) * 0.8 * s)), hex(greens[i + 1]), Enum.Material.Grass, Enum.PartType.Ball)
	end
end

local function mushroom(parent: Instance, base: Vector3, s: number, rnd: Random)
	newPart(parent, Vector3.new(2.2, 0.6, 0.6) * s, CFrame.new(base + Vector3.new(0, 1.1 * s, 0)) * CFrame.Angles(0, 0, math.rad(90)), hex("#f4e3c4"), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	local caps = { "#e2483f", "#f08a2e", "#8f6bd8" }
	local cap = newPart(parent, Vector3.new(3.2, 1.6, 3.2) * s, CFrame.new(base + Vector3.new(0, 2.3 * s, 0)), hex(caps[rnd:NextInteger(1, #caps)]))
	local m = Instance.new("SpecialMesh")
	m.MeshType = Enum.MeshType.Sphere
	m.Parent = cap
	for _ = 1, 5 do
		local a = rnd:NextNumber() * math.pi * 2
		local r = rnd:NextNumber() * 1.1 * s
		newPart(parent, Vector3.new(0.45, 0.45, 0.45) * s, CFrame.new(base + Vector3.new(math.cos(a) * r, 2.3 * s + math.sqrt(math.max(0, 0.64 - (r / (1.6 * s)) ^ 2)) * 0.8 * s * 1.1, math.sin(a) * r)), Color3.new(1, 1, 1), Enum.Material.SmoothPlastic, Enum.PartType.Ball)
	end
end

local function pillar(parent: Instance, base: Vector3, h: number)
	newPart(parent, Vector3.new(h, 1.6, 1.6), CFrame.new(base + Vector3.new(0, h / 2, 0)) * CFrame.Angles(0, 0, math.rad(90)), hex("#c9bfd8"), Enum.Material.Marble, Enum.PartType.Cylinder)
	newPart(parent, Vector3.new(2.3, 0.5, 2.3), CFrame.new(base + Vector3.new(0, h, 0)), hex("#b3a8c6"), Enum.Material.Marble)
	newPart(parent, Vector3.new(2.3, 0.5, 2.3), CFrame.new(base + Vector3.new(0, 0.25, 0)), hex("#b3a8c6"), Enum.Material.Marble)
end

function Board:buildDecor()
	local th = self.theme
	local rnd = Random.new(17 + self.G.li * 31)
	local deco = Instance.new("Folder")
	deco.Name = "Deko"
	deco.Parent = self.folder
	local R = math.max(self.W, self.H) / 2 * TILE
	local halfW, halfH = self.W / 2 * TILE, self.H / 2 * TILE
	local placed, guard = 0, 0
	while placed < 16 and guard < 400 do
		guard += 1
		local a = rnd:NextNumber() * math.pi * 2
		local d = R + 12 + rnd:NextNumber() * 50
		local x, z = math.cos(a) * d, math.sin(a) * d
		if math.abs(x) > halfW + 9 or math.abs(z) > halfH + 9 then
			local size = 4 + rnd:NextNumber() * 6
			newPart(deco, Vector3.new(6, size * 2, size * 2), CFrame.new(x, -3.2, z) * CFrame.Angles(0, 0, math.rad(90)), hex(th.side), Enum.Material.Ground, Enum.PartType.Cylinder)
			newPart(deco, Vector3.new(0.8, size * 2.05, size * 2.05), CFrame.new(x, -0.1, z) * CFrame.Angles(0, 0, math.rad(90)), if th.floor == "stone" then hex("#7a7184") else hex(th.b), if th.floor == "stone" then Enum.Material.Slate else Enum.Material.Grass, Enum.PartType.Cylinder)
			local n = rnd:NextInteger(1, 3)
			for _ = 1, n do
				local p = Vector3.new(x + (rnd:NextNumber() - 0.5) * size, 0.3, z + (rnd:NextNumber() - 0.5) * size)
				if th.decor == "castle" then
					pillar(deco, p, 3 + rnd:NextNumber() * 4)
				elseif rnd:NextNumber() < 0.5 then
					tree(deco, p, 0.8 + rnd:NextNumber() * 0.6, rnd)
				else
					mushroom(deco, p, 0.8 + rnd:NextNumber() * 0.7, rnd)
				end
			end
			placed += 1
		end
	end
	if th.decor == "castle" then
		self:buildCastle(deco)
	elseif th.decor == "ruins" then
		for _ = 1, 6 do
			pillar(deco, Vector3.new((rnd:NextNumber() - 0.5) * (self.W * TILE + 60), -2, -halfH - 22 - rnd:NextNumber() * 30), 6 + rnd:NextNumber() * 10)
		end
	end
end

function Board:buildCastle(parent: Instance)
	local wall, roof, dark = hex("#6a5a86"), hex("#c23cd6"), hex("#3a2d55")
	local z0 = -self.H / 2 * TILE - 50
	newPart(parent, Vector3.new(64, 18, 8), CFrame.new(0, 7, z0), wall, Enum.Material.Brick)
	for i = -3, 3 do
		newPart(parent, Vector3.new(4, 3, 8), CFrame.new(i * 9.2, 17.5, z0), wall, Enum.Material.Brick)
	end
	local towers = { { -34, 28 }, { 34, 28 }, { -14, 38 }, { 14, 38 }, { 0, 48 } }
	for i, t in ipairs(towers) do
		local tz = if i > 2 then z0 - 6 else z0
		newPart(parent, Vector3.new(t[2], 11, 11), CFrame.new(t[1], t[2] / 2 - 2, tz) * CFrame.Angles(0, 0, math.rad(90)), wall, Enum.Material.Brick, Enum.PartType.Cylinder)
		for k = 0, 5 do
			local d = 13 * (1 - k / 6 * 0.9)
			newPart(parent, Vector3.new(2, d, d), CFrame.new(t[1], t[2] - 2 + 1 + k * 2, tz) * CFrame.Angles(0, 0, math.rad(90)), roof, Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
		end
		newPart(parent, Vector3.new(1.4, 2.8, 0.4), CFrame.new(t[1], t[2] * 0.7, tz - 5.5), hex("#ffd27a"), Enum.Material.Neon)
	end
	newPart(parent, Vector3.new(10, 11, 0.8), CFrame.new(0, 3.5, z0 - 4.2 + 8.5), dark)
end

-- ------------------------------------------------------------------ lighting

function Board:applyLighting()
	local th = self.theme
	Lighting.ClockTime = th.clock
	Lighting.Brightness = th.brightness
	Lighting.OutdoorAmbient = hex(th.ambient)
	Lighting.Ambient = hex(th.ambient):Lerp(Color3.new(0, 0, 0), 0.5)
	Lighting.GlobalShadows = true
	Lighting.EnvironmentDiffuseScale = 0.6
	Lighting.EnvironmentSpecularScale = 0.6
	local atm = Lighting:FindFirstChildOfClass("Atmosphere")
	if not atm then
		atm = Instance.new("Atmosphere")
		atm.Parent = Lighting
	end
	atm.Density = 0.28
	atm.Offset = 0.1
	atm.Color = hex(th.atmosphere)
	atm.Decay = hex(th.decay)
	atm.Glare = 0.25
	atm.Haze = 1.2
	local cc = Lighting:FindFirstChild("KrawallFarbe")
	if not cc then
		cc = Instance.new("ColorCorrectionEffect")
		cc.Name = "KrawallFarbe"
		cc.Parent = Lighting
	end
	cc.Saturation = 0.12
	cc.Contrast = 0.05
	local terrain = workspace.Terrain
	terrain.WaterColor = hex(th.water)
end

return Board
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="14">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[-- Animationen und Effekte: Zeit-Tweens (blockierend, für Abläufe), Partikel, Projektile,
-- Schadenszahlen, Ringwellen und Sounds. Alles nur aus Parts und Roblox-eigenen Client-Assets.

local RunService = game:GetService("RunService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Fx = {}
Fx.speed = 1
Fx.muted = false
Fx.shakeAmount = 0
Fx.folder = nil :: Folder?

local INK_DEEP = Color3.fromHex("#120c20")

-- Blockierender Tween: ruft fn(k) mit k von 0 bis 1 auf und kehrt erst danach zurück.
function Fx.tween(dur: number, fn: (number) -> ())
	if dur <= 0 then
		fn(1)
		return
	end
	local t = 0
	fn(0)
	while t < dur do
		local dt = RunService.Heartbeat:Wait()
		t += dt * Fx.speed
		fn(math.min(1, t / dur))
	end
end

function Fx.sleep(s: number)
	Fx.tween(s, function() end)
end

function Fx.ease(k: number): number
	if k < 0.5 then
		return 2 * k * k
	end
	return 1 - ((-2 * k + 2) ^ 2) / 2
end

local function newPart(size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.CastShadow = false
	if shape then
		p.Shape = shape
	end
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = Fx.folder
	return p
end
Fx.newPart = newPart

-- ------------------------------------------------------------------ particles

local particles = {}

function Fx.burst(pos: Vector3, color: Color3, n: number?, spd: number?, life: number?, size: number?, up: number?, grav: number?)
	local count = n or 12
	local speed = spd or 12
	local lifetime = life or 0.55
	local sz = size or 0.36
	local upward = if up == nil then 6 else up
	local g = if grav == nil then 1 else grav
	for _ = 1, count do
		local s = sz * (0.6 + math.random() * 0.8)
		local p = newPart(Vector3.new(s, s, s), CFrame.new(pos), color, Enum.Material.Neon)
		local a = math.random() * math.pi * 2
		local r = speed * (0.3 + math.random() * 0.7)
		table.insert(particles, {
			part = p,
			v = Vector3.new(math.cos(a) * r, upward + math.random() * speed * 0.8, math.sin(a) * r),
			life = lifetime,
			max = lifetime,
			s = s,
			g = g,
			spin = Vector3.new(math.random() * 6, math.random() * 6, 0),
		})
	end
end

function Fx.update(dt: number)
	for i = #particles, 1, -1 do
		local p = particles[i]
		p.life -= dt
		if p.life <= 0 then
			p.part:Destroy()
			table.remove(particles, i)
		else
			p.v += Vector3.new(0, -36 * dt * p.g, 0)
			local s = math.max(0.05, p.s * (p.life / p.max))
			p.part.Size = Vector3.new(s, s, s)
			p.part.CFrame = (p.part.CFrame + p.v * dt) * CFrame.Angles(p.spin.X * dt, p.spin.Y * dt, 0)
		end
	end
	Fx.shakeAmount *= math.exp(-dt * 10)
end

function Fx.clear()
	for _, p in ipairs(particles) do
		p.part:Destroy()
	end
	table.clear(particles)
end

function Fx.shake(a: number)
	Fx.shakeAmount = math.max(Fx.shakeAmount, a)
end

-- ------------------------------------------------------------------ projectiles & waves

function Fx.projectile(from: Vector3, to: Vector3, color: Color3)
	local ball = newPart(Vector3.new(0.55, 0.55, 0.55), CFrame.new(from), color, Enum.Material.Neon, Enum.PartType.Ball)
	local light = Instance.new("PointLight")
	light.Color = color
	light.Range = 8
	light.Brightness = 2
	light.Parent = ball
	local d = (to - from).Magnitude
	local frame = 0
	Fx.tween(math.max(0.12, d / 68), function(k)
		local pos = from:Lerp(to, k) + Vector3.new(0, math.sin(k * math.pi) * d * 0.035, 0)
		ball.CFrame = CFrame.new(pos)
		frame += 1
		if frame % 2 == 0 then
			Fx.burst(pos, color, 1, 1, 0.25, 0.25, 0.4, 0)
		end
	end)
	ball:Destroy()
	Fx.burst(to, color, 10, 10, 0.45, 0.32)
end

function Fx.ringWave(pos: Vector3, color: Color3, radius: number)
	local disc = newPart(Vector3.new(0.2, 1, 1), CFrame.new(pos + Vector3.new(0, 0.3, 0)) * CFrame.Angles(0, 0, math.rad(90)), color, Enum.Material.Neon, Enum.PartType.Cylinder)
	disc.Transparency = 0.35
	Fx.tween(0.45, function(k)
		local d = 1 + Fx.ease(k) * radius * 2
		disc.Size = Vector3.new(0.2, d, d)
		disc.Transparency = 0.35 + 0.6 * k
	end)
	disc:Destroy()
end

-- ------------------------------------------------------------------ floating text

local STYLES = {
	dmg = { color = "#ffe25a", size = 34 },
	heroDmg = { color = "#ff6b6b", size = 34 },
	heal = { color = "#7dff8a", size = 32 },
	miss = { color = "#e2daf3", size = 26 },
	fx = { color = "#ffa24a", size = 26 },
	info = { color = "#8fe9ff", size = 24 },
}

function Fx.floatText(pos: Vector3, text: string, style: string?)
	local st = STYLES[style or "dmg"] or STYLES.dmg
	local anchor = newPart(Vector3.new(0.2, 0.2, 0.2), CFrame.new(pos), Color3.new(1, 1, 1))
	anchor.Transparency = 1
	local bb = Instance.new("BillboardGui")
	bb.Size = UDim2.fromOffset(320, 60)
	bb.AlwaysOnTop = true
	bb.LightInfluence = 0
	bb.Adornee = anchor
	bb.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.FredokaOne
	label.Text = text
	label.TextSize = st.size
	label.TextColor3 = Color3.fromHex(st.color)
	label.Parent = bb
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 3
	stroke.Color = INK_DEEP
	stroke.Parent = label
	task.spawn(function()
		local t = 0
		while t < 1.3 do
			t += RunService.RenderStepped:Wait()
			bb.StudsOffsetWorldSpace = Vector3.new(0, t * 3.6, 0)
			local fade = math.max(0, (t - 0.85) / 0.45)
			label.TextTransparency = fade
			stroke.Transparency = fade
			label.TextSize = if t < 0.12 then st.size * (0.6 + t / 0.12 * 0.5) elseif t < 0.22 then st.size * (1.1 - (t - 0.12)) else st.size
		end
		anchor:Destroy()
	end)
end

-- ------------------------------------------------------------------ sounds (Roblox-eigene Client-Sounds, keine Uploads nötig)

local SOUNDS = {
	select = { "rbxasset://sounds/electronicpingshort.wav", 1.2, 0.35 },
	step = { "rbxasset://sounds/action_footsteps_plastic.mp3", 1.4, 0.15 },
	jump = { "rbxasset://sounds/action_jump.mp3", 1, 0.5 },
	land = { "rbxasset://sounds/action_jump_land.mp3", 1, 0.5 },
	shoot = { "rbxasset://sounds/paintball.wav", 1, 0.45 },
	hit = { "rbxasset://sounds/swordslash.wav", 0.9, 0.5 },
	dash = { "rbxasset://sounds/swordlunge.wav", 1, 0.55 },
	ko = { "rbxasset://sounds/uuhhh.mp3", 1, 0.5 },
	splash = { "rbxasset://sounds/impact_water.mp3", 1, 0.6 },
	crack = { "rbxasset://sounds/collide.wav", 0.8, 0.5 },
	turn = { "rbxasset://sounds/electronicpingshort.wav", 1.5, 0.4 },
	foe = { "rbxasset://sounds/electronicpingshort.wav", 0.6, 0.4 },
	heal = { "rbxasset://sounds/electronicpingshort.wav", 1.9, 0.4 },
	shield = { "rbxasset://sounds/electronicpingshort.wav", 0.9, 0.45 },
	watch = { "rbxasset://sounds/electronicpingshort.wav", 2.2, 0.35 },
	quake = { "rbxasset://sounds/collide.wav", 0.4, 0.8 },
	win = { "rbxasset://sounds/electronicpingshort.wav", 1.3, 0.6 },
	lose = { "rbxasset://sounds/uuhhh.mp3", 0.7, 0.5 },
}

function Fx.sound(name: string)
	if Fx.muted then
		return
	end
	local def = SOUNDS[name]
	if not def then
		return
	end
	local s = Instance.new("Sound")
	s.SoundId = def[1]
	s.PlaybackSpeed = def[2]
	s.Volume = def[3]
	s.Parent = SoundService
	s:Play()
	Debris:AddItem(s, 4)
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="15">
          <Properties>
            <string name="Name">Models</string>
            <string name="Source"><![CDATA[-- 3D-Modelle aus Parts: Helden als Roblox-Blockfiguren mit austauschbaren Skins,
-- Krawallos als runde, einäugige Monster. Vorderseite ist -Z (Roblox-Standard), Ursprung = Füße.

local Models = {}

local FACE = "rbxasset://textures/face.png"
local WHITE = Color3.new(1, 1, 1)
local BLACK = Color3.fromHex("#14101e")

local function hex(c: string): Color3
	return Color3.fromHex(c)
end

local function newPart(model: Instance, shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true
	p.CanCollide = false
	p.CanQuery = false
	p.CanTouch = false
	p.Shape = shape
	p.Size = size
	p.CFrame = cf
	p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = model
	return p
end

-- Baukasten mit Skalierung: alle Maße unskaliert angeben
local function builder(model: Instance, s: number)
	local B = {}
	local function place(cf: CFrame): CFrame
		return CFrame.new(cf.Position * s) * (cf - cf.Position)
	end
	function B.cf(shape: Enum.PartType, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?): Part
		return newPart(model, shape, size * s, place(cf), color, mat)
	end
	function B.block(size: Vector3, pos: Vector3, color: Color3, mat: Enum.Material?, rot: CFrame?): Part
		return B.cf(Enum.PartType.Block, size, CFrame.new(pos) * (rot or CFrame.new()), color, mat)
	end
	function B.ball(d: number, pos: Vector3, color: Color3, mat: Enum.Material?): Part
		return B.cf(Enum.PartType.Ball, Vector3.new(d, d, d), CFrame.new(pos), color, mat)
	end
	function B.ellipsoid(size: Vector3, pos: Vector3, color: Color3, mat: Enum.Material?, rot: CFrame?): Part
		local p = B.block(size, pos, color, mat, rot)
		local m = Instance.new("SpecialMesh")
		m.MeshType = Enum.MeshType.Sphere
		m.Parent = p
		return p
	end
	-- Zylinder entlang der Blickrichtung (Läufe, Linsen)
	function B.zcyl(len: number, d: number, pos: Vector3, color: Color3, mat: Enum.Material?): Part
		return B.cf(Enum.PartType.Cylinder, Vector3.new(len, d, d), CFrame.new(pos) * CFrame.Angles(0, math.rad(90), 0), color, mat)
	end
	-- stehender Zylinder
	function B.vcyl(h: number, d: number, pos: Vector3, color: Color3, mat: Enum.Material?, rot: CFrame?): Part
		return B.cf(Enum.PartType.Cylinder, Vector3.new(h, d, d), CFrame.new(pos) * (rot or CFrame.new()) * CFrame.Angles(0, 0, math.rad(90)), color, mat)
	end
	-- Stufenkegel aus gestapelten Scheiben; base ist die Mitte der Grundfläche
	function B.cone(baseD: number, h: number, steps: number, base: Vector3, color: Color3, mat: Enum.Material?, rot: CFrame?): { Part }
		local frame = CFrame.new(base) * (rot or CFrame.new())
		local parts = {}
		for i = 0, steps - 1 do
			local d = baseD * (1 - (i / steps) * 0.85)
			local cf = frame * CFrame.new(0, h * (i + 0.5) / steps, 0) * CFrame.Angles(0, 0, math.rad(90))
			table.insert(parts, B.cf(Enum.PartType.Cylinder, Vector3.new(h / steps, d, d), cf, color, mat))
		end
		return parts
	end
	return B
end

-- ------------------------------------------------------------------ hero headgear (Kopfmitte y=4.6, Oberkante ~5.22)

local HATS = {}

HATS.zipfel = function(B, sk)
	B.vcyl(0.18, 1.55, Vector3.new(0, 5.2, 0), hex(sk.accent), Enum.Material.Metal)
	B.cone(1.3, 1.45, 5, Vector3.new(0, 5.28, 0.05), hex(sk.hatColor), nil, CFrame.Angles(math.rad(18), 0, 0))
	B.block(Vector3.new(0.12, 0.9, 0.32), Vector3.new(0.6, 5.65, 0.15), WHITE, nil, CFrame.Angles(0, 0, math.rad(-28)))
end

HATS.ritter = function(B, sk)
	B.block(Vector3.new(1.45, 1.4, 1.45), Vector3.new(0, 4.65, 0), hex(sk.hatColor), Enum.Material.Metal)
	B.block(Vector3.new(1.2, 0.14, 0.06), Vector3.new(0, 4.72, -0.74), BLACK)
	B.block(Vector3.new(0.06, 0.5, 0.06), Vector3.new(0, 4.45, -0.74), BLACK)
	local plume = B.block(Vector3.new(0.22, 0.55, 1.3), Vector3.new(0, 5.6, 0.1), hex(sk.accent), Enum.Material.Neon)
	B.block(Vector3.new(0.22, 0.4, 0.7), Vector3.new(0, 5.95, 0.45), hex(sk.accent), Enum.Material.Neon)
	return plume
end

HATS.dreispitz = function(B, sk)
	B.vcyl(0.14, 2.1, Vector3.new(0, 5.22, 0), hex(sk.hatColor))
	B.vcyl(0.06, 2.16, Vector3.new(0, 5.3, 0), hex(sk.accent), Enum.Material.Metal)
	B.vcyl(0.55, 1.35, Vector3.new(0, 5.55, 0), hex(sk.hatColor))
	B.block(Vector3.new(0.34, 0.34, 0.06), Vector3.new(0, 5.55, -0.69), hex(sk.accent), Enum.Material.Metal)
end

HATS.sternkrone = function(B, sk)
	B.vcyl(0.3, 1.42, Vector3.new(0, 5.2, 0), hex("#ffc63d"), Enum.Material.Metal)
	for i = 0, 4 do
		local a = i / 5 * math.pi * 2
		B.block(Vector3.new(0.22, 0.6, 0.22), Vector3.new(math.sin(a) * 0.58, 5.62, math.cos(a) * 0.58), hex(sk.hatColor), Enum.Material.Neon)
	end
end

HATS.stahlhelm = function(B, sk)
	local mat = Enum.Material.Metal
	if sk.material == "Foil" then
		mat = Enum.Material.Foil
	end
	B.ellipsoid(Vector3.new(1.6, 1.15, 1.6), Vector3.new(0, 5.0, 0), hex(sk.hatColor), mat)
	B.vcyl(0.12, 1.72, Vector3.new(0, 4.98, 0), hex(sk.hatColor), mat)
	B.block(Vector3.new(0.18, 0.32, 1.3), Vector3.new(0, 5.55, 0), hex(sk.accent), mat)
end

HATS.hoernerhelm = function(B, sk)
	B.ellipsoid(Vector3.new(1.6, 1.15, 1.6), Vector3.new(0, 5.0, 0), hex(sk.hatColor), Enum.Material.Metal)
	B.vcyl(0.12, 1.72, Vector3.new(0, 4.98, 0), hex(sk.accent), Enum.Material.Neon)
	local horn = hex("#e8d9c0")
	B.cone(0.5, 1.0, 4, Vector3.new(-0.62, 5.2, 0), horn, nil, CFrame.Angles(0, 0, math.rad(35)))
	B.cone(0.5, 1.0, 4, Vector3.new(0.62, 5.2, 0), horn, nil, CFrame.Angles(0, 0, math.rad(-35)))
	local tip = B.ball(0.24, Vector3.new(-1.19, 6.0, 0), hex(sk.glow), Enum.Material.Neon)
	B.ball(0.24, Vector3.new(1.19, 6.0, 0), hex(sk.glow), Enum.Material.Neon)
	return tip
end

HATS.eiskrone = function(B, sk)
	B.vcyl(0.3, 1.42, Vector3.new(0, 5.2, 0), hex(sk.hatColor), Enum.Material.Ice)
	for i = 0, 5 do
		local a = i / 6 * math.pi * 2
		local h = if i % 2 == 0 then 0.95 else 0.6
		local p = B.block(Vector3.new(0.24, h, 0.24), Vector3.new(math.sin(a) * 0.58, 5.3 + h / 2, math.cos(a) * 0.58), hex(sk.hatColor), Enum.Material.Ice)
		p.Transparency = 0.15
	end
end

HATS.blatt = function(B, sk)
	B.block(Vector3.new(1.32, 0.16, 1.32), Vector3.new(0, 4.95, 0), hex("#5a3a22"))
	for _, x in ipairs({ -0.27, 0.27 }) do
		B.zcyl(0.16, 0.48, Vector3.new(x, 4.95, -0.66), hex(sk.accent), Enum.Material.Metal)
		B.zcyl(0.06, 0.32, Vector3.new(x, 4.95, -0.75), hex("#9fe8ff"), Enum.Material.Neon)
	end
	B.vcyl(0.35, 0.08, Vector3.new(0, 5.38, 0), hex("#3a7a2a"))
	B.ellipsoid(Vector3.new(0.45, 0.1, 0.85), Vector3.new(0.12, 5.6, 0.05), hex(sk.hatColor), nil, CFrame.Angles(0, 0, math.rad(25)))
end

HATS.ninja = function(B, sk)
	local fabric = Enum.Material.Fabric
	B.block(Vector3.new(1.36, 0.36, 1.36), Vector3.new(0, 4.98, 0), hex(sk.hatColor), fabric)
	B.block(Vector3.new(1.32, 0.5, 0.18), Vector3.new(0, 4.38, -0.58), hex(sk.hatColor), fabric)
	B.block(Vector3.new(1.45, 0.32, 1.3), Vector3.new(0, 4.05, 0), hex(sk.accent), fabric)
	B.block(Vector3.new(0.22, 0.12, 1.0), Vector3.new(0.25, 4.98, 1.1), hex(sk.accent), fabric, CFrame.Angles(math.rad(-20), math.rad(10), 0))
	B.block(Vector3.new(0.22, 0.12, 0.8), Vector3.new(-0.05, 4.9, 1.0), hex(sk.accent), fabric, CFrame.Angles(math.rad(-30), math.rad(-15), 0))
end

HATS.glashelm = function(B, sk)
	local dome = B.ball(1.95, Vector3.new(0, 4.62, 0), hex(sk.hatColor), Enum.Material.Glass)
	dome.Transparency = 0.6
	B.vcyl(0.28, 1.75, Vector3.new(0, 3.98, 0), hex(sk.accent), Enum.Material.Metal)
	B.vcyl(0.6, 0.06, Vector3.new(0.5, 5.55, 0.2), hex("#c9ccd6"), Enum.Material.Metal)
	B.ball(0.18, Vector3.new(0.5, 5.9, 0.2), hex(sk.glow), Enum.Material.Neon)
end

HATS.regenbogen = function(B, _sk)
	local colors = { "#ff4a4a", "#ff9d2a", "#ffe14a", "#5fd068", "#4fb4ff", "#9a5cf0" }
	for i, c in ipairs(colors) do
		B.block(Vector3.new(0.3, 0.55, 0.26), Vector3.new(0, 5.45, -0.6 + (i - 1) * 0.24), hex(c), Enum.Material.Neon)
	end
end

-- ------------------------------------------------------------------ weapons (rechte Hand bei x=hx, y=3.55, z=-1.75)

local WEAPONS = {}

WEAPONS.leo = function(B, sk, hx)
	B.zcyl(1.4, 0.42, Vector3.new(hx, 3.55, -2.3), hex(sk.weapon), Enum.Material.Metal)
	B.block(Vector3.new(0.3, 0.6, 0.35), Vector3.new(hx, 3.2, -1.95), hex("#3a2a1a"))
	B.ball(0.5, Vector3.new(hx, 3.55, -3.0), hex(sk.glow), Enum.Material.Neon)
	return Vector3.new(hx, 3.55, -3.2)
end

WEAPONS.bruna = function(B, sk, hx)
	B.zcyl(1.8, 0.58, Vector3.new(hx, 3.55, -2.45), hex(sk.weapon), Enum.Material.Metal)
	B.zcyl(0.4, 1.0, Vector3.new(hx, 3.55, -3.4), hex(sk.weapon), Enum.Material.Metal)
	B.zcyl(0.06, 0.7, Vector3.new(hx, 3.55, -3.62), hex(sk.glow), Enum.Material.Neon)
	return Vector3.new(hx, 3.55, -3.7)
end

WEAPONS.pip = function(B, sk, hx)
	B.zcyl(3.0, 0.24, Vector3.new(hx, 3.55, -3.0), hex(sk.weapon), Enum.Material.Metal)
	B.zcyl(0.9, 0.32, Vector3.new(hx, 3.92, -2.4), hex("#6b7088"), Enum.Material.Metal)
	B.block(Vector3.new(0.32, 0.5, 0.9), Vector3.new(hx, 3.35, -1.4), hex("#5a3a22"))
	B.ball(0.3, Vector3.new(hx, 3.55, -4.5), hex(sk.glow), Enum.Material.Neon)
	return Vector3.new(hx, 3.55, -4.6)
end

local HERO_SHAPE = {
	leo = { scale = 0.8, bulk = 1.0 },
	bruna = { scale = 0.86, bulk = 1.25 },
	pip = { scale = 0.7, bulk = 0.95 },
}

local function addEffect(kind: string?, part: BasePart?, glow: Color3)
	if not kind or not part then
		return
	end
	if kind == "fire" then
		local f = Instance.new("Fire")
		f.Size = 2
		f.Heat = 3
		f.Color = glow
		f.SecondaryColor = Color3.fromHex("#ffd84a")
		f.Parent = part
	elseif kind == "smoke" then
		local s = Instance.new("Smoke")
		s.Size = 0.4
		s.Opacity = 0.12
		s.RiseVelocity = 2
		s.Color = Color3.fromHex("#3a3236")
		s.Parent = part
	elseif kind == "sparkles" or kind == "snow" then
		local s = Instance.new("Sparkles")
		s.SparkleColor = glow
		s.Parent = part
	end
end

-- Baut einen Helden im gewählten Skin. Rückgabe: Model und Infos (Mündung, Höhe)
function Models.hero(kind: string, sk)
	local shape = HERO_SHAPE[kind]
	local s = shape.scale
	local bulk = shape.bulk
	local model = Instance.new("Model")
	model.Name = kind
	local B = builder(model, s)
	local mat = if sk.material then Enum.Material[sk.material] else Enum.Material.SmoothPlastic
	local shirt, pants, skinC, accent = hex(sk.shirt), hex(sk.pants), hex(sk.skin), hex(sk.accent)
	local accentMat = if sk.neonAccent then Enum.Material.Neon else Enum.Material.SmoothPlastic
	local tw = 2 * bulk
	local hx = tw / 2 + 0.5
	local armL, armR = shirt, shirt
	if sk.rainbow then
		armL, armR = hex("#4fb4ff"), hex("#ffe14a")
	end
	local shoe = pants:Lerp(BLACK, 0.55)

	-- Beine
	for _, side in ipairs({ -1, 1 }) do
		B.block(Vector3.new(1, 1.6, 1), Vector3.new(0.5 * bulk * side, 1.25, 0), pants, mat)
		B.block(Vector3.new(1.05, 0.45, 1.25), Vector3.new(0.5 * bulk * side, 0.225, -0.1), shoe)
	end
	-- Rumpf mit Gürtel
	local torso = B.block(Vector3.new(tw, 2, 1.05), Vector3.new(0, 3, 0), shirt, mat)
	B.block(Vector3.new(tw + 0.06, 0.3, 1.11), Vector3.new(0, 2.15, 0), accent, accentMat)
	B.block(Vector3.new(0.45, 0.36, 0.08), Vector3.new(0, 2.15, -0.58), hex("#ffd84a"), Enum.Material.Metal)
	if sk.rainbow then
		local stripes = { "#ff4a4a", "#ff9d2a", "#ffe14a", "#5fd068" }
		for i, c in ipairs(stripes) do
			B.block(Vector3.new(tw * 0.92, 0.28, 0.06), Vector3.new(0, 3.75 - (i - 1) * 0.36, -0.55), hex(c), Enum.Material.Neon)
		end
	elseif kind == "leo" and sk.hat == "dreispitz" then
		for i = 0, 2 do
			B.ball(0.2, Vector3.new(0, 3.6 - i * 0.45, -0.56), hex(sk.accent), Enum.Material.Metal)
		end
	end
	if kind == "bruna" then
		for _, side in ipairs({ -1, 1 }) do
			B.ellipsoid(Vector3.new(1.25, 0.7, 1.25), Vector3.new((tw / 2 + 0.35) * side, 4.0, 0), accent, if sk.material then mat else Enum.Material.Metal)
		end
	end
	-- Arme: links hängend, rechts mit der Waffe nach vorn
	B.block(Vector3.new(1, 2, 1), Vector3.new(-hx, 3, 0), armL, mat)
	B.block(Vector3.new(0.9, 0.5, 0.9), Vector3.new(-hx, 1.75, 0), skinC)
	B.block(Vector3.new(1, 2, 1), Vector3.new(hx, 3.55, -0.6), armR, mat, CFrame.Angles(math.rad(90), 0, 0))
	B.block(Vector3.new(0.9, 0.9, 0.5), Vector3.new(hx, 3.55, -1.75), skinC)
	-- Kopf im klassischen Roblox-Stil mit Standardgesicht
	local head = B.block(Vector3.new(1.25, 1.25, 1.25), Vector3.new(0, 4.6, 0), skinC)
	local hm = Instance.new("SpecialMesh")
	hm.MeshType = Enum.MeshType.Head
	hm.Parent = head
	local face = Instance.new("Decal")
	face.Texture = FACE
	face.Face = Enum.NormalId.Front
	face.Parent = head
	if sk.eyepatch then
		B.block(Vector3.new(0.3, 0.28, 0.08), Vector3.new(0.24, 4.68, -0.66), BLACK)
		B.block(Vector3.new(1.32, 0.07, 1.32), Vector3.new(0, 4.85, 0), BLACK, nil, CFrame.Angles(0, 0, math.rad(-14)))
	end
	if sk.backpack then
		B.block(Vector3.new(1.6, 1.6, 0.7), Vector3.new(0, 3.1, 0.88), hex("#e6e8ee"))
		for _, side in ipairs({ -1, 1 }) do
			B.vcyl(1.3, 0.5, Vector3.new(0.42 * side, 3.15, 1.35), accent, Enum.Material.Metal)
		end
	end
	local hatFn = HATS[sk.hat]
	local effectPart = nil
	if hatFn then
		effectPart = hatFn(B, sk)
	end
	local muzzle = WEAPONS[kind](B, sk, hx)
	addEffect(sk.effect, effectPart or torso, hex(sk.glow))
	model.WorldPivot = CFrame.new()
	return model, { muzzle = muzzle * s, height = 5.6 * s, glow = hex(sk.glow) }
end

-- ------------------------------------------------------------------ enemies

local ENEMY_SCALE = { grunt = 0.95, sniper = 0.88, brute = 1.2, king = 1.45 }

function Models.enemy(kind: string, def)
	local s = ENEMY_SCALE[kind] or 1
	local model = Instance.new("Model")
	model.Name = kind
	local B = builder(model, s)
	local c = hex(def.color)
	local light = c:Lerp(WHITE, 0.35)
	local dark = c:Lerp(Color3.new(0, 0, 0), 0.25)
	local horn = hex("#ffe7b0")
	for _, side in ipairs({ -1, 1 }) do
		B.ellipsoid(Vector3.new(0.95, 0.42, 1.15), Vector3.new(0.6 * side, 0.21, -0.2), dark)
	end
	B.ball(3.0, Vector3.new(0, 1.65, 0), c)
	B.ball(2.0, Vector3.new(0, 1.45, -0.62), light)
	B.ball(1.1, Vector3.new(0, 2.2, -1.12), WHITE)
	B.ball(0.52, Vector3.new(0, 2.2, -1.6), BLACK)
	B.ball(0.15, Vector3.new(0.13, 2.36, -1.84), WHITE, Enum.Material.Neon)
	B.block(Vector3.new(0.95, 0.16, 0.14), Vector3.new(0, 1.22, -1.42), BLACK)
	for _, side in ipairs({ -1, 1 }) do
		B.block(Vector3.new(0.2, 0.18, 0.08), Vector3.new(0.22 * side, 1.12, -1.48), WHITE)
	end
	B.cone(0.46, 0.9, 4, Vector3.new(-0.62, 2.85, 0), horn, nil, CFrame.Angles(0, 0, math.rad(25)))
	B.cone(0.46, 0.9, 4, Vector3.new(0.62, 2.85, 0), horn, nil, CFrame.Angles(0, 0, math.rad(-25)))
	local muzzle, top = Vector3.new(1.35, 1.5, -1.7), 3.6
	if kind == "grunt" then
		B.zcyl(1.4, 0.38, Vector3.new(1.35, 1.5, -0.95), hex("#5b5f70"), Enum.Material.Metal)
		B.ball(0.3, Vector3.new(1.35, 1.5, -1.7), hex("#ff5fd2"), Enum.Material.Neon)
	elseif kind == "sniper" then
		B.zcyl(2.4, 0.2, Vector3.new(1.25, 1.75, -1.0), hex("#7a4a2a"))
		B.ball(0.3, Vector3.new(1.25, 1.75, -2.25), hex("#ffc63d"), Enum.Material.Neon)
		B.vcyl(1.0, 0.08, Vector3.new(0, 3.55, 0.1), hex("#1f6f52"))
		B.ball(0.28, Vector3.new(0, 4.1, 0.1), hex("#ffc63d"), Enum.Material.Neon)
		muzzle = Vector3.new(1.25, 1.75, -2.3)
		top = 4.2
	elseif kind == "brute" then
		for _, side in ipairs({ -1, 1 }) do
			B.ball(1.05, Vector3.new(1.75 * side, 1.35, -0.55), light)
		end
		B.block(Vector3.new(1.3, 0.22, 0.25), Vector3.new(0, 2.78, -1.22), BLACK, nil, CFrame.Angles(math.rad(20), 0, 0))
		muzzle = Vector3.new(0, 1.5, -1.6)
	elseif kind == "king" then
		local gold = hex("#ffc63d")
		B.vcyl(0.45, 1.3, Vector3.new(0, 3.3, 0), gold, Enum.Material.Metal)
		for i = 0, 4 do
			local a = i / 5 * math.pi * 2
			B.block(Vector3.new(0.2, 0.45, 0.2), Vector3.new(math.sin(a) * 0.55, 3.72, math.cos(a) * 0.55), gold, Enum.Material.Metal)
		end
		B.ball(0.24, Vector3.new(0, 3.3, -0.66), hex("#ff3d6e"), Enum.Material.Neon)
		B.block(Vector3.new(2.7, 2.5, 0.16), Vector3.new(0, 1.7, 1.3), hex("#7d1f9e"), Enum.Material.Fabric, CFrame.Angles(math.rad(-12), 0, 0))
		B.vcyl(2.8, 0.14, Vector3.new(1.75, 1.6, -0.45), hex("#6b4a2a"))
		B.ball(0.5, Vector3.new(1.75, 3.05, -0.45), gold, Enum.Material.Metal)
		muzzle = Vector3.new(1.75, 3.05, -0.8)
		top = 4.1
	end
	model.WorldPivot = CFrame.new()
	return model, { muzzle = muzzle * s, height = top * s }
end

return Models
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="16">
          <Properties>
            <string name="Name">Ui</string>
            <string name="Source"><![CDATA[-- Benutzeroberfläche: HUD im Kampf und Menüs (Titel, Garderobe mit 3D-Vorschau, Regeln, Pause, Ende).
-- Alles per Code gebaut; die Spiellogik hängt sich über die Handler-Funktionen an.

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Models = require(script.Parent.Models)

local Ui = {}
Ui.__index = Ui

local function hex(c: string): Color3
	return Color3.fromHex(c)
end

local C = {
	ink = hex("#241a3a"),
	ink2 = hex("#33275a"),
	line = hex("#4b3a78"),
	deep = hex("#120c20"),
	paper = hex("#fff4dc"),
	muted = hex("#b9add6"),
	gold = hex("#ffc63d"),
	goldDeep = hex("#c97f0c"),
	violet = hex("#6d5bd0"),
	violetDeep = hex("#3f2f8f"),
	good = hex("#5fd068"),
	warn = hex("#ffc63d"),
	bad = hex("#ff5a5a"),
	foe = hex("#ff8aa3"),
}
Ui.C = C

local DISPLAY = Enum.Font.FredokaOne
local BODY = Enum.Font.GothamMedium
local BOLD = Enum.Font.GothamBold

local BUTTON_STYLES = {
	gold = { bg = C.gold, fg = hex("#3a2300"), deep = C.goldDeep },
	violet = { bg = C.violet, fg = Color3.new(1, 1, 1), deep = C.violetDeep },
	on = { bg = hex("#fff4dc"), fg = hex("#3a2300"), deep = hex("#c9b98f") },
	off = { bg = hex("#43375e"), fg = hex("#8f84a8"), deep = hex("#261d3b") },
	tool = { bg = C.ink, fg = C.paper, deep = C.deep },
}

local function make(class: string, props, children)
	local inst = Instance.new(class)
	local parent = nil
	for k, v in pairs(props or {}) do
		if k == "Parent" then
			parent = v
		else
			inst[k] = v
		end
	end
	for _, c in ipairs(children or {}) do
		c.Parent = inst
	end
	if parent then
		inst.Parent = parent
	end
	return inst
end

local function corner(r: number)
	return make("UICorner", { CornerRadius = UDim.new(0, r) })
end

local function roundCorner()
	return make("UICorner", { CornerRadius = UDim.new(0.5, 0) })
end

local function stroke(color: Color3, th: number)
	return make("UIStroke", { Color = color, Thickness = th, ApplyStrokeMode = Enum.ApplyStrokeMode.Border })
end

local function textStroke(color: Color3, th: number)
	return make("UIStroke", { Color = color, Thickness = th, ApplyStrokeMode = Enum.ApplyStrokeMode.Contextual })
end

local function padding(t: number, r: number?, b: number?, l: number?)
	return make("UIPadding", {
		PaddingTop = UDim.new(0, t),
		PaddingRight = UDim.new(0, r or t),
		PaddingBottom = UDim.new(0, b or t),
		PaddingLeft = UDim.new(0, l or r or t),
	})
end

local function list(dir: Enum.FillDirection, gap: number, halign: Enum.HorizontalAlignment?, valign: Enum.VerticalAlignment?)
	return make("UIListLayout", {
		FillDirection = dir,
		Padding = UDim.new(0, gap),
		SortOrder = Enum.SortOrder.LayoutOrder,
		HorizontalAlignment = halign or Enum.HorizontalAlignment.Left,
		VerticalAlignment = valign or Enum.VerticalAlignment.Top,
	})
end

local function label(props)
	local base = {
		BackgroundTransparency = 1,
		Font = BODY,
		TextColor3 = C.paper,
		TextSize = 15,
		TextXAlignment = Enum.TextXAlignment.Left,
		TextYAlignment = Enum.TextYAlignment.Top,
		TextWrapped = true,
		RichText = true,
	}
	for k, v in pairs(props) do
		base[k] = v
	end
	return make("TextLabel", base)
end

-- auto-hoher Textblock in voller Breite
local function para(parent, text: string, size: number, color: Color3?, font: Enum.Font?, order: number?)
	return label({
		Parent = parent,
		Text = text,
		TextSize = size,
		TextColor3 = color or C.paper,
		Font = font or BODY,
		Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		LayoutOrder = order or 0,
	})
end

local function panel(props)
	local f = make("Frame", props)
	f.BackgroundColor3 = C.ink
	f.BackgroundTransparency = 0.04
	f.BorderSizePixel = 0
	corner(16).Parent = f
	stroke(C.line, 2).Parent = f
	return f
end

-- Knopf mit "3D"-Schatten. Rückgabe: Steuerobjekt mit set(enabled, style) und setText(text)
local function button(parent, text: string, style: string, size: UDim2, order: number?, onClick: (() -> ())?)
	local holder = make("Frame", { Name = text, Size = size, BackgroundTransparency = 1, LayoutOrder = order or 0, Parent = parent })
	local shadow = make("Frame", { Size = UDim2.new(1, 0, 1, -4), Position = UDim2.fromOffset(0, 4), BorderSizePixel = 0, Parent = holder }, { corner(12) })
	local btn = make("TextButton", {
		Size = UDim2.new(1, 0, 1, -4),
		Font = DISPLAY,
		TextSize = 18,
		Text = text,
		AutoButtonColor = false,
		BorderSizePixel = 0,
		Parent = holder,
	}, { corner(12) })
	local state = { style = style, enabled = true, holder = holder, btn = btn }
	local function paint()
		local st = BUTTON_STYLES[if state.enabled then state.style else "off"]
		btn.BackgroundColor3 = st.bg
		btn.TextColor3 = st.fg
		shadow.BackgroundColor3 = st.deep
	end
	function state.set(_, enabled: boolean, styleName: string?)
		if styleName then
			state.style = styleName
		end
		state.enabled = enabled
		paint()
	end
	function state.setText(_, t: string)
		btn.Text = t
	end
	btn.MouseButton1Down:Connect(function()
		if state.enabled then
			btn.Position = UDim2.fromOffset(0, 3)
		end
	end)
	btn.MouseButton1Up:Connect(function()
		btn.Position = UDim2.new()
	end)
	btn.MouseLeave:Connect(function()
		btn.Position = UDim2.new()
	end)
	btn.Activated:Connect(function()
		btn.Position = UDim2.new()
		if state.enabled and onClick then
			onClick()
		end
	end)
	paint()
	return state
end

local function card(parent, width: number, name: string)
	local f = panel({
		Name = name,
		Parent = parent,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(width, 0),
		AutomaticSize = Enum.AutomaticSize.Y,
		Visible = false,
	})
	padding(24, 28).Parent = f
	list(Enum.FillDirection.Vertical, 12).Parent = f
	return f
end

local function row(parent, height: number, gap: number, order: number?)
	local f = make("Frame", { Size = UDim2.new(1, 0, 0, height), BackgroundTransparency = 1, LayoutOrder = order or 0, Parent = parent })
	list(Enum.FillDirection.Horizontal, gap).Parent = f
	return f
end

-- ------------------------------------------------------------------ construction

function Ui.new(handlers)
	local self = setmetatable({}, Ui)
	self.h = handlers
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")

	self.hud = make("ScreenGui", { Name = "KrawallHUD", ResetOnSpawn = false, IgnoreGuiInset = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 5, Enabled = false, Parent = pg })
	self.menus = make("ScreenGui", { Name = "KrawallMenus", ResetOnSpawn = false, IgnoreGuiInset = true, ZIndexBehavior = Enum.ZIndexBehavior.Sibling, DisplayOrder = 10, Parent = pg })
	self.hudScale = make("UIScale", { Parent = self.hud })
	self.menuScale = make("UIScale", { Parent = self.menus })

	self:buildHud()
	self:buildMenus()
	self:updateScale()
	local cam = workspace.CurrentCamera
	cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		self:updateScale()
	end)
	return self
end

function Ui:updateScale()
	local vp = workspace.CurrentCamera.ViewportSize
	local s = math.clamp(math.min(vp.X / 1280, vp.Y / 740), 0.5, 1.2)
	self.scale = s
	self.hudScale.Scale = s
	self.menuScale.Scale = math.clamp(math.min(vp.X / 900, vp.Y / 760), 0.45, 1.15)
end

-- ------------------------------------------------------------------ HUD

function Ui:buildHud()
	local hud = self.hud
	-- Level-Infos oben links
	local top = panel({ Parent = hud, Position = UDim2.fromOffset(12, 12), Size = UDim2.fromOffset(320, 0), AutomaticSize = Enum.AutomaticSize.Y })
	padding(10, 14, 12, 14).Parent = top
	list(Enum.FillDirection.Vertical, 3).Parent = top
	self.lvlNum = label({ Parent = top, Text = "KAMPF 1", Font = BOLD, TextSize = 12, TextColor3 = C.muted, Size = UDim2.new(1, 0, 0, 14), LayoutOrder = 1 })
	self.lvlName = label({ Parent = top, Text = "Pilzwiese", Font = DISPLAY, TextSize = 24, Size = UDim2.new(1, 0, 0, 26), LayoutOrder = 2 })
	local rl = row(top, 22, 8, 3)
	self.roundTxt = label({ Parent = rl, Text = "Runde 1", Font = BOLD, TextSize = 16, Size = UDim2.fromOffset(0, 22), AutomaticSize = Enum.AutomaticSize.X, TextYAlignment = Enum.TextYAlignment.Center })
	self.pill = label({
		Parent = rl,
		Text = "DEIN ZUG",
		Font = BOLD,
		TextSize = 12,
		TextColor3 = hex("#0f2a12"),
		BackgroundTransparency = 0,
		BackgroundColor3 = C.good,
		Size = UDim2.fromOffset(0, 22),
		AutomaticSize = Enum.AutomaticSize.X,
		TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Center,
		LayoutOrder = 2,
	})
	padding(0, 9).Parent = self.pill
	roundCorner().Parent = self.pill
	self.goalTxt = para(top, "Ziel: Besiege alle Krawallos", 13, C.muted, BODY, 4)

	-- Werkzeugknöpfe oben rechts
	local tools = make("Frame", { Parent = hud, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(4 * 52 + 3 * 8, 50), BackgroundTransparency = 1 })
	list(Enum.FillDirection.Horizontal, 8, Enum.HorizontalAlignment.Right).Parent = tools
	button(tools, "?", "tool", UDim2.fromOffset(52, 50), 1, function()
		self.h.onHelp()
	end)
	self.speedBtn = button(tools, "1×", "tool", UDim2.fromOffset(52, 50), 2, function()
		self.h.onSpeed()
	end)
	self.soundBtn = button(tools, "Ton", "tool", UDim2.fromOffset(52, 50), 3, function()
		self.h.onSound()
	end)
	button(tools, "II", "tool", UDim2.fromOffset(52, 50), 4, function()
		self.h.onPause()
	end)

	-- Heldenkarten unten links
	local cards = make("Frame", { Parent = hud, AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -12), Size = UDim2.fromOffset(260, 3 * 78 + 16), BackgroundTransparency = 1 })
	list(Enum.FillDirection.Vertical, 8, Enum.HorizontalAlignment.Left, Enum.VerticalAlignment.Bottom).Parent = cards
	self.cardFrame = cards
	self.heroCards = {}

	-- Aktionsleiste unten rechts
	local ap = panel({ Parent = hud, AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -12, 1, -12), Size = UDim2.fromOffset(600, 0), AutomaticSize = Enum.AutomaticSize.Y })
	padding(12, 14).Parent = ap
	list(Enum.FillDirection.Vertical, 10).Parent = ap
	self.info = para(ap, "", 14, C.paper, BODY, 1)
	local br = row(ap, 50, 8, 2)
	self.btnMove = button(br, "Laufen [L]", "gold", UDim2.fromOffset(122, 50), 1, function()
		self.h.onMode("move")
	end)
	self.btnAttack = button(br, "Angriff [F]", "gold", UDim2.fromOffset(128, 50), 2, function()
		self.h.onMode("attack")
	end)
	self.btnTech = button(br, "Technik [T]", "gold", UDim2.fromOffset(150, 50), 3, function()
		self.h.onTech()
	end)
	self.btnEnd = button(br, "Zug beenden", "violet", UDim2.fromOffset(150, 50), 4, function()
		self.h.onEndTurn()
	end)

	-- Tooltip
	self.tip = make("Frame", { Parent = hud, BackgroundColor3 = C.deep, BackgroundTransparency = 0.04, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new(), Visible = false, ZIndex = 20 }, { corner(12), stroke(C.line, 2), padding(8, 12) })
	self.tipLabel = label({ Parent = self.tip, Text = "", TextSize = 14, AutomaticSize = Enum.AutomaticSize.XY, Size = UDim2.new(), ZIndex = 21, TextWrapped = false })

	-- Banner
	self.banner = make("Frame", { Parent = hud, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.33), Size = UDim2.fromOffset(900, 120), BackgroundTransparency = 1, Visible = false })
	self.bannerScale = make("UIScale", { Parent = self.banner })
	self.bannerTitle = label({ Parent = self.banner, Text = "", Font = DISPLAY, TextSize = 68, TextColor3 = C.gold, Size = UDim2.new(1, 0, 0, 78), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
	self.bannerTitleStroke = textStroke(hex("#5a2a06"), 4)
	self.bannerTitleStroke.Parent = self.bannerTitle
	self.bannerSub = label({ Parent = self.banner, Text = "", Font = BOLD, TextSize = 20, Position = UDim2.fromOffset(0, 82), Size = UDim2.new(1, 0, 0, 26), TextXAlignment = Enum.TextXAlignment.Center })
	textStroke(C.deep, 2).Parent = self.bannerSub
end

function Ui:buildHeroCards(heroList)
	for _, c in pairs(self.heroCards) do
		c.frame:Destroy()
	end
	self.heroCards = {}
	for i, u in ipairs(heroList) do
		local color = hex(u.def.color)
		local f = make("TextButton", { Parent = self.cardFrame, Size = UDim2.fromOffset(240, 78), BackgroundColor3 = C.ink, BackgroundTransparency = 0.04, AutoButtonColor = false, Text = "", LayoutOrder = i })
		corner(14).Parent = f
		local st = stroke(C.line, 2)
		st.Parent = f
		local face = make("Frame", { Parent = f, Position = UDim2.fromOffset(10, 10), Size = UDim2.fromOffset(40, 40), BackgroundColor3 = color }, { roundCorner() })
		label({ Parent = face, Text = string.sub(u.name, 1, 1), Font = DISPLAY, TextSize = 22, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center })
		label({ Parent = f, Text = u.name, Font = DISPLAY, TextSize = 19, Position = UDim2.fromOffset(60, 8), Size = UDim2.fromOffset(100, 22) })
		local hp = label({ Parent = f, Text = "", Font = BOLD, TextSize = 13, TextColor3 = C.muted, AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 11), Size = UDim2.fromOffset(80, 16), TextXAlignment = Enum.TextXAlignment.Right })
		local bar = make("Frame", { Parent = f, Position = UDim2.fromOffset(60, 33), Size = UDim2.new(1, -72, 0, 9), BackgroundColor3 = C.deep, BorderSizePixel = 0 }, { corner(5) })
		local fill = make("Frame", { Parent = bar, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.good, BorderSizePixel = 0 }, { corner(5) })
		local pips = make("Frame", { Parent = f, Position = UDim2.fromOffset(10, 52), Size = UDim2.new(1, -20, 0, 18), BackgroundTransparency = 1 })
		list(Enum.FillDirection.Horizontal, 5).Parent = pips
		local function pip(text: string, order: number)
			local p = label({ Parent = pips, Text = text, Font = BOLD, TextSize = 11, BackgroundTransparency = 0, BackgroundColor3 = C.ink2, Size = UDim2.fromOffset(0, 18), AutomaticSize = Enum.AutomaticSize.X, TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Center, LayoutOrder = order, TextWrapped = false })
			padding(0, 7).Parent = p
			corner(6).Parent = p
			return p
		end
		local entry = {
			frame = f,
			stroke = st,
			hp = hp,
			fill = fill,
			color = color,
			pm = pip("LAUF", 1),
			pa = pip("SCHUSS", 2),
			pt = pip("TECHNIK", 3),
		}
		f.Activated:Connect(function()
			self.h.onSelectHero(i)
		end)
		self.heroCards[i] = entry
	end
end

-- data: Liste {hp, maxHp, alive, moved, attacked, techReady, cd, selected}
function Ui:setHeroes(data)
	for i, d in ipairs(data) do
		local c = self.heroCards[i]
		if c then
			c.hp.Text = d.hp .. "/" .. d.maxHp
			local r = d.hp / d.maxHp
			c.fill.Size = UDim2.fromScale(r, 1)
			c.fill.BackgroundColor3 = if r > 0.5 then C.good elseif r > 0.25 then C.warn else C.bad
			c.stroke.Color = if d.selected then c.color else C.line
			c.stroke.Thickness = if d.selected then 3 else 2
			c.frame.BackgroundColor3 = if d.alive then C.ink else hex("#2a2534")
			local function dim(p, used: boolean)
				p.TextTransparency = if used then 0.65 else 0
				p.BackgroundTransparency = if used then 0.6 else 0
			end
			dim(c.pm, d.moved or not d.alive)
			dim(c.pa, d.attacked or not d.alive)
			dim(c.pt, not d.techReady or not d.alive)
			c.pt.Text = if d.cd > 0 then "TECHNIK " .. d.cd else "TECHNIK"
		end
	end
end

function Ui:setLevel(li: number, L)
	self.lvlNum.Text = "KAMPF " .. li
	self.lvlName.Text = L.name
	self.goalTxt.Text = "Ziel: " .. L.goal
end

function Ui:setRound(round: number, phase: string)
	self.roundTxt.Text = "Runde " .. round
	if phase == "enemy" then
		self.pill.Text = "GEGNERZUG"
		self.pill.BackgroundColor3 = C.foe
		self.pill.TextColor3 = hex("#2a0710")
	else
		self.pill.Text = "DEIN ZUG"
		self.pill.BackgroundColor3 = C.good
		self.pill.TextColor3 = hex("#0f2a12")
	end
end

-- s: {move, attack, tech, endTurn = enabled-Flags; mode; techLabel; pulse}
function Ui:setActions(s)
	self.btnMove:set(s.move, if s.mode == "move" then "on" else "gold")
	self.btnAttack:set(s.attack, if s.mode == "attack" then "on" else "gold")
	self.btnTech:set(s.tech, if s.mode == "tech" then "on" else "gold")
	self.btnTech:setText(s.techLabel)
	self.btnEnd:set(s.endTurn, if s.pulse then "gold" else "violet")
	self.btnEnd:setText(if s.pulse then "Zug beenden!" else "Zug beenden")
end

function Ui:setInfo(text: string)
	self.info.Text = text
end

function Ui:showTip(text: string, x: number, y: number)
	self.tipLabel.Text = text
	self.tip.Visible = true
	local s = self.scale or 1
	local vp = workspace.CurrentCamera.ViewportSize
	local w, h = self.tip.AbsoluteSize.X, self.tip.AbsoluteSize.Y
	local px, py = x + 18, y + 18
	if px + w > vp.X - 8 then
		px = x - w - 14
	end
	if py + h > vp.Y - 70 then
		py = y - h - 14
	end
	self.tip.Position = UDim2.fromOffset(math.max(8, px) / s, math.max(8, py) / s)
end

function Ui:hideTip()
	self.tip.Visible = false
end

-- Großes Banner in der Bildschirmmitte (nicht blockierend)
function Ui:showBanner(title: string, sub: string?, foe: boolean?)
	self.bannerTitle.Text = title
	self.bannerSub.Text = sub or ""
	self.bannerTitle.TextColor3 = if foe then C.foe else C.gold
	self.bannerTitleStroke.Color = if foe then hex("#4a0a1a") else hex("#5a2a06")
	self.banner.Visible = true
	self.bannerScale.Scale = 0.6
	self.bannerTitle.TextTransparency = 0
	self.bannerSub.TextTransparency = 0
	self.bannerToken = (self.bannerToken or 0) + 1
	local token = self.bannerToken
	TweenService:Create(self.bannerScale, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	task.delay(1.15, function()
		if token ~= self.bannerToken then
			return
		end
		TweenService:Create(self.bannerTitle, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		TweenService:Create(self.bannerSub, TweenInfo.new(0.3), { TextTransparency = 1 }):Play()
		task.delay(0.32, function()
			if token == self.bannerToken then
				self.banner.Visible = false
			end
		end)
	end)
end

function Ui:setHudVisible(v: boolean)
	self.hud.Enabled = v
end

-- ------------------------------------------------------------------ menus

function Ui:buildMenus()
	local m = self.menus
	self.backdrop = make("Frame", { Parent = m, Size = UDim2.fromScale(1, 1), BackgroundColor3 = C.deep, BackgroundTransparency = 0.4, BorderSizePixel = 0 })
	self.screens = {}
	self:buildTitle()
	self:buildSkins()
	self:buildHelp()
	self:buildPause()
	self:buildEnd()
end

function Ui:show(name: string?)
	self.menus.Enabled = name ~= nil
	for n, f in pairs(self.screens) do
		f.Visible = n == name
	end
	self.current = name
	if name ~= "skins" and self.previewConn then
		self.previewConn:Disconnect()
		self.previewConn = nil
	end
end

function Ui:buildTitle()
	local c = card(self.menus, 800, "title")
	self.screens.title = c
	para(c, "RUNDENTAKTIK IN 3D · 3 GEFECHTE · 12 HELDEN-SKINS", 13, C.muted, BOLD, 1)
	local logo1 = label({ Parent = c, Text = "KRAWALL", Font = DISPLAY, TextSize = 78, TextColor3 = C.gold, Size = UDim2.new(1, 0, 0, 80), LayoutOrder = 2, TextWrapped = false })
	textStroke(hex("#5a2a06"), 4).Parent = logo1
	local logo2 = label({ Parent = c, Text = "KÖNIGREICH", Font = DISPLAY, TextSize = 56, TextColor3 = C.paper, Size = UDim2.new(1, 0, 0, 60), LayoutOrder = 3, TextWrapped = false })
	textStroke(C.violetDeep, 4).Parent = logo2
	para(c, "Die Krawallos haben das Königreich gestürmt. Führe Leo, Bruna und Pip durch drei Gefechte: in Deckung gehen, per Teamsprung übers Feld fliegen, Gegner im Sprint umrennen. Jeder Sieg schaltet neue Skins frei.", 16, hex("#e9e0fa"), BODY, 4)
	self.levelRow = row(c, 150, 10, 5)
	local br = row(c, 58, 10, 6)
	button(br, "Spielen", "gold", UDim2.fromOffset(170, 58), 1, function()
		self.h.onPlay()
	end)
	button(br, "Helden-Skins", "violet", UDim2.fromOffset(190, 58), 2, function()
		self.h.onOpenSkins()
	end)
	button(br, "So spielst du", "violet", UDim2.fromOffset(180, 58), 3, function()
		self.h.onHelp()
	end)
end

-- levels: Config.LEVELS, won: gewonnene Kämpfe, best: Bestwerte, pick: gewählter Kampf
function Ui:setLevels(levels, won: number, best, pick: number, enemyCounts)
	for _, ch in ipairs(self.levelRow:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	for i, L in ipairs(levels) do
		local locked = i > won + 1
		local b = make("TextButton", {
			Parent = self.levelRow,
			Size = UDim2.new(1 / 3, -7, 1, 0),
			BackgroundColor3 = if i == pick then hex("#3d2f68") else C.ink2,
			AutoButtonColor = false,
			Text = "",
			LayoutOrder = i,
		})
		corner(14).Parent = b
		stroke(if i == pick then C.gold else C.line, 2).Parent = b
		padding(10, 12).Parent = b
		list(Enum.FillDirection.Vertical, 3).Parent = b
		para(b, "KAMPF " .. i .. (if locked then " · GESPERRT" else ""), 11, C.muted, BOLD, 1)
		para(b, L.name, 19, C.paper, DISPLAY, 2)
		para(b, L.blurb, 12, hex("#d9cff0"), BODY, 3)
		local meta = enemyCounts[i] .. " Gegner · Ziel " .. L.par .. " Runden"
		local bs = best[tostring(i)]
		if bs then
			meta ..= "\n<font color=\"#ffc63d\">Bestwert: " .. ({ "Geschafft", "Stark", "Meisterhaft" })[bs.score] .. " in " .. bs.turn .. " Runden</font>"
		end
		para(b, meta, 12, C.muted, BOLD, 4)
		if locked then
			for _, d in ipairs(b:GetDescendants()) do
				if d:IsA("TextLabel") then
					d.TextTransparency = 0.5
				end
			end
		end
		b.Activated:Connect(function()
			if not locked then
				self.h.onPickLevel(i)
			end
		end)
	end
end

-- ------------------------------------------------------------------ Garderobe

function Ui:buildSkins()
	local c = card(self.menus, 860, "skins")
	self.screens.skins = c
	para(c, "HELDEN-SKINS", 13, C.muted, BOLD, 1)
	local t = label({ Parent = c, Text = "Garderobe", Font = DISPLAY, TextSize = 46, TextColor3 = C.gold, Size = UDim2.new(1, 0, 0, 50), LayoutOrder = 2, TextWrapped = false })
	textStroke(hex("#5a2a06"), 3).Parent = t
	para(c, "Jeder Held hat vier Outfits. Neue Skins schaltest du frei, indem du Kämpfe gewinnst. Der ausgerüstete Skin erscheint im Kampf.", 15, hex("#e9e0fa"), BODY, 3)
	local tabs = row(c, 48, 8, 4)
	self.skinTabs = {}
	for i, heroKind in ipairs({ "leo", "bruna", "pip" }) do
		self.skinTabs[heroKind] = button(tabs, ({ "Leo", "Bruna", "Pip" })[i], "violet", UDim2.fromOffset(130, 48), i, function()
			self.skinHero = heroKind
			self.skinFocus = nil
			self:refreshSkins()
		end)
	end
	local body = row(c, 340, 16, 5)
	local vpf = make("ViewportFrame", {
		Parent = body,
		Size = UDim2.fromOffset(300, 340),
		BackgroundColor3 = C.ink2,
		Ambient = Color3.fromRGB(165, 160, 190),
		LightColor = Color3.fromRGB(255, 244, 225),
		LightDirection = Vector3.new(-0.6, -1, 0.5),
		LayoutOrder = 1,
	}, { corner(16) })
	local vcam = Instance.new("Camera")
	vcam.FieldOfView = 38
	vcam.CFrame = CFrame.lookAt(Vector3.new(0, 3.4, -11), Vector3.new(0, 2.5, 0))
	vcam.Parent = vpf
	vpf.CurrentCamera = vcam
	self.viewport = vpf
	self.skinNameLabel = label({ Parent = vpf, Text = "", Font = DISPLAY, TextSize = 22, Position = UDim2.new(0, 0, 1, -40), Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center })
	textStroke(C.deep, 2).Parent = self.skinNameLabel
	local listFrame = make("Frame", { Parent = body, Size = UDim2.new(1, -316, 1, 0), BackgroundTransparency = 1, LayoutOrder = 2 })
	list(Enum.FillDirection.Vertical, 8).Parent = listFrame
	self.skinList = listFrame
	self.skinDesc = para(c, "", 15, C.paper, BODY, 6)
	local br = row(c, 56, 10, 7)
	self.equipBtn = button(br, "Ausrüsten", "gold", UDim2.fromOffset(180, 56), 1, function()
		if self.skinFocus then
			self.h.onEquip(self.skinHero, self.skinFocus)
		end
	end)
	button(br, "Zurück", "violet", UDim2.fromOffset(140, 56), 2, function()
		self.h.onCloseSkins()
	end)
	self.skinHero = "leo"
end

-- Garderobe öffnen; skins = Skins-Modul, progress = {won, skins = {held = id}}
function Ui:openSkins(skinsModule, progress)
	self.skinsModule = skinsModule
	self.progress = progress
	self.skinFocus = nil
	self:show("skins")
	self:refreshSkins()
	if self.previewConn then
		self.previewConn:Disconnect()
	end
	local t0 = os.clock()
	self.previewConn = RunService.RenderStepped:Connect(function()
		if self.previewModel then
			self.previewModel:PivotTo(CFrame.Angles(0, math.sin((os.clock() - t0) * 0.9) * 0.9, 0))
		end
	end)
end

function Ui:refreshSkins()
	local Skins = self.skinsModule
	local progress = self.progress
	if not Skins or not progress then
		return
	end
	local heroKind = self.skinHero
	local equipped = progress.skins[heroKind]
	self.skinFocus = self.skinFocus or equipped
	for kind, b in pairs(self.skinTabs) do
		b:set(true, if kind == heroKind then "gold" else "violet")
	end
	for _, ch in ipairs(self.skinList:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	local focusSkin = Skins.get(heroKind, self.skinFocus)
	for i, sk in ipairs(Skins.HEROES[heroKind]) do
		local unlocked = progress.won >= sk.unlock
		local focused = sk.id == focusSkin.id
		local b = make("TextButton", { Parent = self.skinList, Size = UDim2.new(1, 0, 0, 78), BackgroundColor3 = if focused then hex("#3d2f68") else C.ink2, AutoButtonColor = false, Text = "", LayoutOrder = i })
		corner(14).Parent = b
		stroke(if focused then C.gold else C.line, 2).Parent = b
		local sw = make("Frame", { Parent = b, Position = UDim2.fromOffset(12, 14), Size = UDim2.fromOffset(50, 50), BackgroundColor3 = hex(sk.shirt) }, { corner(10), stroke(C.deep, 2) })
		make("Frame", { Parent = sw, Position = UDim2.fromScale(0, 0.62), Size = UDim2.fromScale(1, 0.38), BackgroundColor3 = hex(sk.pants), BorderSizePixel = 0 }, { corner(8) })
		make("Frame", { Parent = sw, AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.25), Size = UDim2.fromOffset(18, 18), BackgroundColor3 = hex(sk.hatColor) }, { roundCorner(), stroke(C.deep, 1.5) })
		label({ Parent = b, Text = sk.name, Font = DISPLAY, TextSize = 20, Position = UDim2.fromOffset(76, 12), Size = UDim2.new(1, -90, 0, 24), TextColor3 = if unlocked then C.paper else C.muted })
		local status
		if sk.id == equipped then
			status = "<font color=\"#5fd068\">AUSGERÜSTET</font>"
		elseif unlocked then
			status = "FREIGESCHALTET"
		else
			status = "<font color=\"#ff8aa3\">GESPERRT</font> · Sieg in Kampf " .. sk.unlock
		end
		label({ Parent = b, Text = status, Font = BOLD, TextSize = 12, Position = UDim2.fromOffset(76, 42), Size = UDim2.new(1, -90, 0, 18), TextColor3 = C.muted })
		b.Activated:Connect(function()
			self.skinFocus = sk.id
			self:refreshSkins()
		end)
	end
	local unlocked = progress.won >= focusSkin.unlock
	self.skinDesc.Text = "<b>" .. focusSkin.name .. ":</b> " .. focusSkin.desc .. (if unlocked then "" else "  <font color=\"#ff8aa3\">Gewinne Kampf " .. focusSkin.unlock .. ", um ihn freizuschalten.</font>")
	self.skinNameLabel.Text = focusSkin.name
	self.equipBtn:set(unlocked and focusSkin.id ~= equipped, "gold")
	self.equipBtn:setText(if focusSkin.id == equipped then "Ausgerüstet" elseif unlocked then "Ausrüsten" else "Gesperrt")
	-- 3D-Vorschau neu bauen
	if self.previewModel then
		self.previewModel:Destroy()
	end
	local model = Models.hero(heroKind, focusSkin)
	model.Parent = self.viewport
	model:PivotTo(CFrame.new())
	self.previewModel = model
	if not unlocked then
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") then
				d.Color = d.Color:Lerp(Color3.fromRGB(40, 32, 60), 0.75)
			end
		end
	end
end

-- ------------------------------------------------------------------ Regeln

function Ui:buildHelp()
	local c = card(self.menus, 880, "help")
	self.screens.help = c
	para(c, "SPIELREGELN", 13, C.muted, BOLD, 1)
	local t = label({ Parent = c, Text = "So spielst du", Font = DISPLAY, TextSize = 42, TextColor3 = C.gold, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 2, TextWrapped = false })
	textStroke(hex("#5a2a06"), 3).Parent = t
	local grid = make("Frame", { Parent = c, Size = UDim2.new(1, 0, 0, 4 * 86 + 3 * 10), BackgroundTransparency = 1, LayoutOrder = 3 })
	make("UIGridLayout", { Parent = grid, CellSize = UDim2.new(0.5, -8, 0, 86), CellPadding = UDim2.fromOffset(16, 10), SortOrder = Enum.SortOrder.LayoutOrder })
	local rules = {
		{ "#3fa8ff", "Laufen", "Blaue Felder zeigen, wie weit dein Held laufen kann. Erst laufen, dann angreifen: nach dem Schuss ist die Bewegung vorbei." },
		{ "#ffc63d", "Teamsprung", "Goldene Felder erreichst du über einen Verbündeten: er wirft dich bis zu 3 Felder weit, auch über Mauern." },
		{ "#ff8a2a", "Sprintangriff", "Oranger Umriss: Renne einmal pro Zug in einen Gegner. Danach darfst du weiterlaufen." },
		{ "#ff5fd2", "Sprungangriff", "Pinker Umriss: Springe per Teamsprung auf einen Gegner. 30 Schaden, danach endet die Bewegung." },
		{ "#5fd068", "Trefferchance", "100 % ohne Deckung, 50 % hinter Kisten, 0 % hinter Steinmauern. Flankiere von der Seite!" },
		{ "#c98a4b", "Kisten gehen kaputt", "Ein Fehlschuss auf ein Ziel hinter einer Kiste beschädigt sie. Nach zwei Treffern ist sie weg." },
		{ "#ff7a2f", "Super-Effekte", "Brand: 15 Schaden im nächsten Zug. Rückstoß: schiebt weg, Wasser kostet 50 LP. Honig: Gegner klebt fest." },
		{ "#5ee3d2", "Techniken", "Leo: Wachsamkeit (Reaktionsschuss). Bruna: Bollwerk (halber Schaden). Pip: Heilwelle. Danach Abklingzeit." },
	}
	for i, r in ipairs(rules) do
		local cell = make("Frame", { Parent = grid, BackgroundTransparency = 1, LayoutOrder = i })
		make("Frame", { Parent = cell, Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(0, 3), BackgroundColor3 = hex(r[1]) }, { corner(6) })
		label({ Parent = cell, Text = r[2], Font = DISPLAY, TextSize = 17, TextColor3 = C.gold, Position = UDim2.fromOffset(34, 0), Size = UDim2.new(1, -34, 0, 22) })
		label({ Parent = cell, Text = r[3], TextSize = 13, TextColor3 = hex("#e3daf5"), Position = UDim2.fromOffset(34, 24), Size = UDim2.new(1, -34, 1, -24) })
	end
	local keys = para(c,
		"<b>Maus:</b> Klick wählt und handelt · Ziehen mit rechter Maustaste dreht die Kamera · Mausrad zoomt · mittlere Maustaste verschiebt\n"
			.. "<b>Tasten:</b> 1–3 Held · Tab nächster Held · L Laufen · F Angriff · T Technik · Enter Zug beenden · X Abbrechen · Q/E drehen · WASD verschieben · P Pause\n"
			.. "<b>Touch:</b> Einmal tippen zeigt die Vorschau, nochmal tippen bestätigt · Wischen dreht · Zwei Finger zoomen",
		13, hex("#e3daf5"), BODY, 4)
	keys.BackgroundTransparency = 0
	keys.BackgroundColor3 = C.ink2
	corner(12).Parent = keys
	padding(10, 14).Parent = keys
	local br = row(c, 56, 10, 5)
	button(br, "Verstanden", "gold", UDim2.fromOffset(190, 56), 1, function()
		self.h.onCloseHelp()
	end)
end

-- ------------------------------------------------------------------ Pause & Ende

function Ui:buildPause()
	local c = card(self.menus, 520, "pause")
	self.screens.pause = c
	para(c, "PAUSE", 13, C.muted, BOLD, 1)
	local t = label({ Parent = c, Text = "Kurze Rast", Font = DISPLAY, TextSize = 42, TextColor3 = C.gold, Size = UDim2.new(1, 0, 0, 46), LayoutOrder = 2, TextWrapped = false })
	textStroke(hex("#5a2a06"), 3).Parent = t
	self.pauseInfo = para(c, "", 16, hex("#e9e0fa"), BODY, 3)
	local br = row(c, 56, 10, 4)
	button(br, "Weiter", "gold", UDim2.fromOffset(130, 56), 1, function()
		self.h.onResume()
	end)
	button(br, "Neu starten", "violet", UDim2.fromOffset(160, 56), 2, function()
		self.h.onRestart()
	end)
	button(br, "Hauptmenü", "violet", UDim2.fromOffset(150, 56), 3, function()
		self.h.onToTitle()
	end)
end

function Ui:showPause(text: string)
	self.pauseInfo.Text = text
	self:show("pause")
end

function Ui:buildEnd()
	local c = card(self.menus, 680, "ending")
	self.screens.ending = c
	self.endEyebrow = para(c, "", 13, C.muted, BOLD, 1)
	self.endTitle = label({ Parent = c, Text = "Sieg!", Font = DISPLAY, TextSize = 60, TextColor3 = C.gold, Size = UDim2.new(1, 0, 0, 64), LayoutOrder = 2, TextWrapped = false })
	self.endTitleStroke = textStroke(hex("#5a2a06"), 4)
	self.endTitleStroke.Parent = self.endTitle
	self.endRating = para(c, "", 17, C.paper, DISPLAY, 3)
	local stats = make("Frame", { Parent = c, Size = UDim2.new(1, 0, 0, 70), BackgroundTransparency = 1, LayoutOrder = 4 })
	list(Enum.FillDirection.Horizontal, 10).Parent = stats
	self.endStats = {}
	for i = 1, 4 do
		local s = make("Frame", { Parent = stats, Size = UDim2.new(0.25, -8, 1, 0), BackgroundColor3 = C.ink2, LayoutOrder = i }, { corner(12), padding(8, 12) })
		local k = label({ Parent = s, Text = "", Font = BOLD, TextSize = 11, TextColor3 = C.muted, Size = UDim2.new(1, 0, 0, 14) })
		local v = label({ Parent = s, Text = "", Font = DISPLAY, TextSize = 28, Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 32) })
		self.endStats[i] = { k = k, v = v }
	end
	self.endUnlock = para(c, "", 15, C.paper, BODY, 5)
	self.endUnlock.BackgroundTransparency = 0
	self.endUnlock.BackgroundColor3 = hex("#3d2f68")
	corner(12).Parent = self.endUnlock
	padding(10, 14).Parent = self.endUnlock
	self.endButtons = row(c, 56, 10, 6)
end

-- d: {eyebrow, title, won, rating, stats = {{k, v}...}, unlock = text?, buttons = {{text, style, fn}...}}
function Ui:showEnd(d)
	self.endEyebrow.Text = d.eyebrow
	self.endTitle.Text = d.title
	self.endTitle.TextColor3 = if d.won then C.gold else C.foe
	self.endTitleStroke.Color = if d.won then hex("#5a2a06") else hex("#4a0a1a")
	self.endRating.Text = d.rating
	for i, st in ipairs(d.stats) do
		self.endStats[i].k.Text = st[1]
		self.endStats[i].v.Text = st[2]
	end
	self.endUnlock.Visible = d.unlock ~= nil
	self.endUnlock.Text = d.unlock or ""
	for _, ch in ipairs(self.endButtons:GetChildren()) do
		if ch:IsA("GuiObject") then
			ch:Destroy()
		end
	end
	for i, b in ipairs(d.buttons) do
		button(self.endButtons, b[1], b[2], UDim2.fromOffset(if b[2] == "gold" then 210 else 170, 56), i, b[3])
	end
	self:show("ending")
end

return Ui
]]></string>
          </Properties>
        </Item>
      </Item>
    </Item>
  </Item>
</roblox>