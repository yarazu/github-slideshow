# ---------------------------------------------------------------------------
# Raumplaner – Konfiguration
# Kopieren nach ".env" und anpassen. Danach den Raumplaner neu starten.
# ---------------------------------------------------------------------------

# Adresse, unter der Kolleginnen und Kollegen den Raumplaner öffnen.
# Wird für Links in E-Mails und das Kalender-Abo verwendet.
PUBLIC_URL=http://localhost:3000
PORT=3000

# Alle Zeiten werden in dieser Zeitzone angezeigt und geplant.
APP_TIMEZONE=Europe/Berlin

# Ablageort für Datenbank und Sicherungen (Standard: ./data)
# DATA_DIR=./data

# ---------------------------------------------------------------- E-Mail (SMTP)
# Ohne SMTP_HOST gibt es nur In-App- und Desktop-Benachrichtigungen.
# Microsoft 365 / Exchange Online: smtp.office365.com, Port 587
# Google Workspace:                smtp.gmail.com,     Port 587 (App-Passwort)
# Interner Exchange-Relay:          z. B. mail.firma.local, Port 25, ohne Benutzer
SMTP_HOST=
SMTP_PORT=587
# true nur für Port 465 (direktes TLS); bei 587 wird automatisch STARTTLS genutzt
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Raumplaner <raumplaner@firma.de>"
# Nur bei internem Mailserver mit selbst signiertem Zertifikat auf false setzen:
# SMTP_TLS_REJECT_UNAUTHORIZED=true

# Zum Ausprobieren: E-Mails nur ins Server-Protokoll schreiben statt zu versenden
# MAIL_LOG_ONLY=true

# ---------------------------------------------------------------- Betrieb
# Hinter einem Reverse Proxy (nginx, Traefik, IIS, Apache …) einschalten:
# TRUST_PROXY=true
# Sichere Cookies (wird bei https:// in PUBLIC_URL automatisch aktiviert):
# COOKIE_SECURE=true

# Automatische Datensicherung (0 = aus) und Anzahl aufbewahrter Sicherungen
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP=14

# Wie lange man angemeldet bleibt (Tage)
# SESSION_DAYS=30
