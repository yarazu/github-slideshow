# Kopiere diese Datei nach ".env" und trage deine Keys ein.
# Die .env wird nie eingecheckt (siehe .gitignore).

# --- Claude: Skripte, Themenideen, Trend-Recherche ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
# Denktiefe: low | medium | high
ANTHROPIC_EFFORT=medium
# Fakten vor dem Schreiben per Websuche recherchieren (echte Quellen-URLs).
# Empfohlen. Kostet pro Suche extra; Websuche muss in der Claude Console erlaubt sein.
SCRIPT_WEB_SEARCH=true
# Nur falls ANTHROPIC_API_KEY schon anderweitig belegt ist (z. B. Cloud-/Agenten-Umgebung):
# FACTORY_ANTHROPIC_API_KEY=
# Die Pipeline spricht immer https://api.anthropic.com an (ANTHROPIC_BASE_URL wird bewusst ignoriert);
# eigener Endpunkt nur hierüber:
# FACTORY_ANTHROPIC_BASE_URL=

# --- Stimme ---
# azure | elevenlabs   (eigene Aufnahme: python make.py ... --voice-file aufnahme.mp3)
TTS_PROVIDER=azure

# Azure AI Speech (Standard)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
# Sprechtempo: +5% = etwas zügiger als normal (TikTok-Tempo)
AZURE_SPEECH_RATE=+5%

# ElevenLabs (optional)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# --- B-Roll ---
PEXELS_API_KEY=
